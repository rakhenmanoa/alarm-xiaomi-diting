From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nazar Kompanets <xlie7669@gmail.com>
Date: Thu, 13 Aug 2026 01:07:04 +0300
Subject: [PATCH 40/46] net: ipa: add `IPA_MEM_MODEM_STATS_DROP` in v5.1

Signed-off-by: Nazar Kompanets <xlie7669@gmail.com>
---
 drivers/net/ipa/data/ipa_data-v5.1.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/net/ipa/data/ipa_data-v5.1.c b/drivers/net/ipa/data/ipa_data-v5.1.c
index 5b955e7c9..03de51ae6 100644
--- a/drivers/net/ipa/data/ipa_data-v5.1.c
+++ b/drivers/net/ipa/data/ipa_data-v5.1.c
@@ -419,6 +419,12 @@ static const struct ipa_mem ipa_mem_local_data[] = {
 		.size		= 0x0100,
 		.canary_count	= 2,
 	},
+	{
+		.id		= IPA_MEM_MODEM_STATS_DROP,
+		.offset		= 0x4fe8,
+		.size		= 0x0018,
+		.canary_count	= 0,
+	},
 };
 
 /* Memory configuration data for an SoC having IPA v5.1 */
