From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:22:43 +0200
Subject: [PATCH 43/46] arm64: dts: qcom: sm8475-xiaomi-diting: Enable IPA

IPA v5.1 carries the modem's mobile data. The GSI firmware is the
device-signed vendor ipa_fws image (squashed); the vendor device tree
loads it into ipa_gsi_region@8b910000 (ipa_gsi_mem), so use that region
rather than ipa_fw_mem.
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index ace9772eb..7a0fe54bf 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -503,6 +503,15 @@ eusb2_repeater: redriver@4f {
 	};
 };
 
+&ipa {
+	qcom,gsi-loader = "self";
+	/* vendor: ipa_fws (PAS 15) is loaded into ipa_gsi_region@8b910000 */
+	memory-region = <&ipa_gsi_mem>;
+	firmware-name = "qcom/sm8475/xiaomi/diting/ipa_fws.mbn";
+
+	status = "okay";
+};
+
 &remoteproc_mpss {
 	/* squashed from the vendor firmware_mnt modem.mdt + modem.bNN */
 	firmware-name = "qcom/sm8475/xiaomi/diting/modem.mbn";
