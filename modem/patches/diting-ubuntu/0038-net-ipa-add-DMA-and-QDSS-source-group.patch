From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nazar Kompanets <xlie7669@gmail.com>
Date: Thu, 13 Aug 2026 00:00:07 +0300
Subject: [PATCH 38/46] net: ipa: add `DMA` and `QDSS` source group

Signed-off-by: Nazar Kompanets <xlie7669@gmail.com>
---
 drivers/net/ipa/data/ipa_data-v5.1.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ipa/data/ipa_data-v5.1.c b/drivers/net/ipa/data/ipa_data-v5.1.c
index a6b6f2c82..5b955e7c9 100644
--- a/drivers/net/ipa/data/ipa_data-v5.1.c
+++ b/drivers/net/ipa/data/ipa_data-v5.1.c
@@ -30,8 +30,8 @@ enum ipa_rsrc_group_id {
 	/* Source resource group identifiers */
 	IPA_RSRC_GROUP_SRC_UL				= 0,
 	IPA_RSRC_GROUP_SRC_DL,
-	IPA_RSRC_GROUP_SRC_UNUSED_2,
-	IPA_RSRC_GROUP_SRC_UNUSED_3,
+	IPA_RSRC_GROUP_SRC_DMA,
+	IPA_RSRC_GROUP_SRC_QDSS,
 	IPA_RSRC_GROUP_SRC_URLLC,
 	IPA_RSRC_GROUP_SRC_U_RX_QC,
 	IPA_RSRC_GROUP_SRC_COUNT,	/* Last in set; not a source group */
@@ -215,6 +215,12 @@ static const struct ipa_resource ipa_resource_src[] = {
 		.limits[IPA_RSRC_GROUP_SRC_UL] = {
 			.min = 0,	.max = 63,
 		},
+		.limits[IPA_RSRC_GROUP_SRC_DMA] = {
+			.min = 0,	.max = 63,
+		},
+		.limits[IPA_RSRC_GROUP_SRC_QDSS] = {
+			.min = 0,	.max = 63,
+		},
 		.limits[IPA_RSRC_GROUP_SRC_URLLC] = {
 			.min = 1,	.max = 63,
 		},
