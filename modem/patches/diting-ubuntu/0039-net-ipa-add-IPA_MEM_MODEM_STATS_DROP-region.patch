From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nazar Kompanets <xlie7669@gmail.com>
Date: Thu, 13 Aug 2026 01:05:12 +0300
Subject: [PATCH 39/46] net: ipa: add `IPA_MEM_MODEM_STATS_DROP` region

Signed-off-by: Nazar Kompanets <xlie7669@gmail.com>
---
 drivers/net/ipa/ipa_mem.c | 5 +++++
 drivers/net/ipa/ipa_mem.h | 1 +
 2 files changed, 6 insertions(+)

diff --git a/drivers/net/ipa/ipa_mem.c b/drivers/net/ipa/ipa_mem.c
index 078d32a18..e8100f63c 100644
--- a/drivers/net/ipa/ipa_mem.c
+++ b/drivers/net/ipa/ipa_mem.c
@@ -158,6 +158,11 @@ static bool ipa_mem_id_valid(struct ipa *ipa, enum ipa_mem_id mem_id)
 			return false;
 		break;
 
+	case IPA_MEM_MODEM_STATS_DROP:
+		if (version < IPA_VERSION_5_0 || version > IPA_VERSION_5_1)
+			return false;
+		break;
+
 	case IPA_MEM_STATS_V4_FILTER:
 	case IPA_MEM_STATS_V6_FILTER:
 	case IPA_MEM_STATS_V4_ROUTE:
diff --git a/drivers/net/ipa/ipa_mem.h b/drivers/net/ipa/ipa_mem.h
index b25babade..3a8e9723c 100644
--- a/drivers/net/ipa/ipa_mem.h
+++ b/drivers/net/ipa/ipa_mem.h
@@ -68,6 +68,7 @@ enum ipa_mem_id {
 	IPA_MEM_STATS_QUOTA_AP,		/* 0 canaries, optional (IPA v4.0+) */
 	IPA_MEM_STATS_TETHERING,	/* 0 canaries, optional (IPA v4.0+) */
 	IPA_MEM_STATS_DROP,		/* 0 canaries, optional (IPA v4.0+) */
+	IPA_MEM_MODEM_STATS_DROP,	/* 0 canaries (IPA v5.0-v5.1) */
 	/* The next 7 filter and route statistics regions are optional */
 	IPA_MEM_STATS_V4_FILTER,	/* 0 canaries (IPA v4.0-v4.2) */
 	IPA_MEM_STATS_V6_FILTER,	/* 0 canaries (IPA v4.0-v4.2) */
