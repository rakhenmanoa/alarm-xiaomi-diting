# Utilisé seulement si le dépôt ALARM ne fournit pas « rmtfs »
pkgname=rmtfs
_commit=b30a3eb38f9af283f18dbd3c7755653efc52c094
pkgver=1.3
pkgrel=1
pkgdesc="Service de stockage distant (EFS) pour le modem Qualcomm"
arch=(aarch64)
url="https://github.com/linux-msm/rmtfs"
license=(BSD-3-Clause)
depends=(qrtr systemd-libs)
makedepends=(git)
source=("rmtfs::git+https://github.com/linux-msm/rmtfs.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd rmtfs
  # les sources QMI générées sont fournies : éviter d'avoir besoin de qmic
  touch qmi_rmtfs.c qmi_rmtfs.h
}
build() {
  cd rmtfs
  make prefix=/usr
}
package() {
  cd rmtfs
  make prefix=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
