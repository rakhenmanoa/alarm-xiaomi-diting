[Unit]
Description=Services QSEE pour la TrustZone (RPMB, fichiers de calibration du capteur d'empreintes)
Documentation=https://github.com/rakhenmanoa/alarm-xiaomi-diting/blob/main/extra/empreintes/README.md
# La partition persist (calibration d'usine Goodix) est montée en lecture
# seule par mnt-vendor-persist.mount.
RequiresMountsFor=/mnt/vendor/persist
After=systemd-modules-load.service

[Service]
Type=notify
NotifyAccess=main
# -f : fichiers en lecture seule sous /mnt/vendor/persist (gfdit) ;
# pas de -w : le RPMB reste en lecture seule.
ExecStart=/usr/bin/diting-qseecomd -f
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
