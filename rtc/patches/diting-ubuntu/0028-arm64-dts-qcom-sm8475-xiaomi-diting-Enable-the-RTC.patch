From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Mon, 12 Oct 2026 15:33:15 +0200
Subject: [PATCH 28/46] arm64: dts: qcom: sm8475-xiaomi-diting: Enable the RTC

Needed for wake alarms (suspend tests, alarms). Time setting stays
disabled; Android keeps its offset in userspace.
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 5fee1ea04..5c936cd0d 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -686,6 +686,11 @@ platform {
 	};
 };
 
+/* Read-only RTC (Android keeps the offset in userspace); wake alarms */
+&pmk8350_rtc {
+	status = "okay";
+};
+
 &pcie0 {
 	max-link-speed = <2>;
 	status = "okay";
