From: alarm-diting
Subject: [PATCH] arm64: dts: qcom: sm8475-xiaomi-diting: Goodix GT9916 touchscreen variant

---
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -960,15 +960,21 @@
 &spi4 {
 	status = "okay";
 
+	/*
+	 * The diting ships with either an ST FTM5 or a Goodix GT9916 touch
+	 * controller on the same bus, pins and supplies (vendor xiaomi,l12-spi
+	 * node carries both fts,* and goodix,* properties). This unit has the
+	 * Goodix one: mainline goodix_berlin_spi driver.
+	 */
 	touchscreen@0 {
-		compatible = "st,ftm5-spi";
+		compatible = "goodix,gt9916";
 		reg = <0>;
-		spi-max-frequency = <12000000>;
+		spi-max-frequency = <1000000>;
 
 		interrupts-extended = <&tlmm 21 IRQ_TYPE_LEVEL_LOW>;
 		reset-gpios = <&tlmm 20 GPIO_ACTIVE_LOW>;
 
-		vdd-supply = <&vreg_l2c_1p8>;
+		vddio-supply = <&vreg_l2c_1p8>;
 		avdd-supply = <&ts_avdd>;
 
 		/* 10x the panel resolution ("super resolution" firmware) */
