-	static constexpr uint8_t kExpDenominator = 10;
-	static constexpr uint8_t kExpNumeratorUp = kExpDenominator + 1;
-	static constexpr uint8_t kExpNumeratorDown = kExpDenominator - 1;
+	maxFrameDuration_ = tuningData["maxFrameDuration"].get<double>(100000.0) * 1us;
+	gainThreshold_ = tuningData["gainThreshold"].get<double>(4.0);
 
-	int32_t &exposure = frameContext.sensor.exposure;
-	double &again = frameContext.sensor.gain;
+	return 0;
+}
 
-	if (exposureMSV < kExposureOptimal - kExposureSatisfactory) {
-		if (exposure < context.configuration.agc.exposureMax) {
-			int32_t next = exposure * kExpNumeratorUp / kExpDenominator;
-			if (next - exposure < 1)
-				exposure += 1;
-			else
-				exposure = next;
-		} else {
-			double next = again * kExpNumeratorUp / kExpDenominator;
-			if (next - again < context.configuration.agc.againMinStep)
-				again += context.configuration.agc.againMinStep;
-			else
-				again = next;
-		}
+int Agc::configure(IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.configuration.agc;
+
+	agc.exposureMaxLong = agc.exposureMax;
+	if (agc.hasVblank && agc.lineDuration > 0us) {
+		/* One more line of blanking allows one more line of exposure */
+		int32_t longest = static_cast<int32_t>(maxFrameDuration_ / agc.lineDuration);
+		int32_t extra = std::clamp<int32_t>(longest - agc.exposureMax, 0,
+						    agc.vblankMax - agc.vblankDefault);
+		agc.exposureMaxLong = agc.exposureMax + extra;
 	}
 
-	if (exposureMSV > kExposureOptimal + kExposureSatisfactory) {
-		if (again > context.configuration.agc.again10) {
-			double next = again * kExpNumeratorDown / kExpDenominator;
-			if (again - next < context.configuration.agc.againMinStep)
-				again -= context.configuration.agc.againMinStep;
-			else
-				again = next;
-		} else {
-			int32_t next = exposure * kExpNumeratorDown / kExpDenominator;
-			if (exposure - next < 1)
-				exposure -= 1;
-			else
-				exposure = next;
-		}
+	context.activeState.agc.vblank = agc.vblankDefault;
+
+	LOG(IPASoftExposure, Debug)
+		<< "Exposure up to " << agc.exposureMax << " lines at the mode's "
+		<< "frame length, " << agc.exposureMaxLong << " with longer frames";
+
+	return 0;
+}
+
+/*
+ * Split a total exposure (exposure lines x analogue gain) into exposure
+ * time, gain and frame lengthening: exposure time up to the mode's frame
+ * first, then gain up to the threshold, then longer frames, then the rest
+ * of the gain range.
+ */
+void Agc::splitExposure(IPAContext &context, double total,
+			int32_t &exposure, double &gain, int32_t &vblank)
+{
+	const auto &agc = context.configuration.agc;
+	const double gainMin = agc.againMin;
+	const double gainMax = agc.againMax;
+	const double gainThreshold = std::clamp(gainThreshold_, gainMin, gainMax);
+	const double shortMax = agc.exposureMax;
+	const double longMax = agc.exposureMaxLong;
+	double exp;
+
+	total = std::clamp(total, agc.exposureMin * gainMin, longMax * gainMax);
+
+	if (total <= shortMax * gainMin) {
+		exp = total / gainMin;
+		gain = gainMin;
+	} else if (total <= shortMax * gainThreshold) {
+		exp = shortMax;
+		gain = total / shortMax;
+	} else if (total <= longMax * gainThreshold) {
+		exp = total / gainThreshold;
+		gain = gainThreshold;
+	} else {
+		exp = longMax;
+		gain = total / longMax;
 	}
 
-	exposure = std::clamp(exposure, context.configuration.agc.exposureMin,
-			      context.configuration.agc.exposureMax);
-	again = std::clamp(again, context.configuration.agc.againMin,
-			   context.configuration.agc.againMax);
+	exposure = std::clamp<int32_t>(std::lround(exp), agc.exposureMin,
+				       agc.exposureMaxLong);
+	gain = std::clamp(gain, gainMin, gainMax);
+	vblank = agc.vblankDefault +
+		 std::max<int32_t>(0, exposure - agc.exposureMax);
+}
+
+void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
+{
+	int32_t &exposure = frameContext.sensor.exposure;
+	double &again = frameContext.sensor.gain;
+	int32_t &vblank = frameContext.sensor.vblank;
+
+	if (std::abs(exposureMSV - kExposureOptimal) <= kExposureSatisfactory)
+		return;
+
+	/*
+	 * Proportional correction of the total exposure: the mean sample
+	 * value is roughly proportional to it when far from the target,
+	 * smaller steps close to it avoid oscillations. At most 2x per step
+	 * (the statistics are not linear when clipped).
+	 */
+	double ratio = kExposureOptimal / std::max(exposureMSV, 0.1);
+	if (std::abs(exposureMSV - kExposureOptimal) < 1.0)
+		ratio = std::sqrt(ratio);
+	ratio = std::clamp(ratio, 0.5, 2.0);
+
+	double total = static_cast<double>(exposure) * again * ratio;
+	splitExposure(context, total, exposure, again, vblank);
 
 	context.activeState.agc.exposure = exposure;
 	context.activeState.agc.again = again;
+	context.activeState.agc.vblank = vblank;
 
 	LOG(IPASoftExposure, Debug)
-		<< "exposureMSV " << exposureMSV
-		<< " exp " << exposure << " again " << again;
+		<< "exposureMSV " << exposureMSV << " ratio " << ratio
+		<< " exp " << exposure << " again " << again
+		<< " vblank " << vblank;
 }
 
