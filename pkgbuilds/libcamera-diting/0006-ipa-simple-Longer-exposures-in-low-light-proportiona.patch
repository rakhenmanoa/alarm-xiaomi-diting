 	if (score > af.bestScore) {
 		af.bestScore = score;
 		af.bestPosition = af.position;
+		af.drops = 0;
 	}
 	af.minScore = std::min(af.minScore, score);
 
-	if (af.position + af.step <= af.stop + 1e-6) {
+	/*
+	 * Coarse pass: past a clear peak (the measure fell below peakDrop of
+	 * the best for peakDropSteps steps), the rest of the range is not
+	 * needed.
+	 */
+	bool pastPeak = false;
+	if (!af.fine && score < af.bestScore * peakDrop_ &&
+	    af.bestScore > af.minScore * 1.15)
+		pastPeak = ++af.drops >= peakDropSteps_;
+
+	if (!pastPeak && af.position + af.step <= af.stop + 1e-6) {
 		af.position += af.step;
 		af.settle = settleFrames_;
 		return;
@@ -128,8 +152,10 @@ void Af::scanStep(IPAContext &context, double score)
 	if (!af.fine) {
 		/* Fine pass around the best coarse position */
 		af.fine = true;
-		af.start = std::clamp(af.bestPosition - coarseStep_, 0.0, 100.0);
-		af.stop = std::clamp(af.bestPosition + coarseStep_, 0.0, 100.0);
+		/* Grid centred on the coarse peak, so that it is measured again */
+		double half = fineStep_ * std::floor(fineRange_ / fineStep_);
+		af.start = std::clamp(af.bestPosition - half, rangeMin_, rangeMax_);
+		af.stop = std::clamp(af.bestPosition + half, rangeMin_, rangeMax_);
 		af.step = fineStep_;
 		af.position = af.start;
 		af.bestScore = 0.0;
