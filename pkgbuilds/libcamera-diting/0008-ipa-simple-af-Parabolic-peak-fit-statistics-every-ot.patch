@@ -43,7 +43,7 @@ public:
 	 * Run stats once every 4 frames to ensure any previous
 	 * exposure changes have been applied.
 	 */
-	static constexpr uint32_t kStatPerNumFrames = 4;
+	static constexpr uint32_t kStatPerNumFrames = 2;
 
 	bool isValid() const { return sharedStats_.fd().isValid(); }
 
diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index be47afc..f0fc835 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -8,9 +8,9 @@
  * absolute second derivative of green in the centre of the image, divided
  * by the green level so that exposure changes do not count as focus
  * changes). A scan visits the lens range in coarse steps, then the
- * neighbourhood of the best coarse position in fine steps, waiting a few
+ * neighbourhood of the best coarse position (see below), waiting a few
  * statistics periods after every lens move (the statistics are gathered on
- * every fourth frame, which is enough for a voice coil lens to settle). In continuous mode a scan is started at
+ * every other frame, which is enough for a voice coil lens to settle). In continuous mode a scan is started at
  * the beginning and again when the measure at the chosen position changes
  * for several frames (scene change). Lens positions are on a 0..100 scale
  * mapped linearly onto the lens driver's focus range.
@@ -21,6 +21,11 @@
  * range can be limited (rangeMin, rangeMax: positions the module can
  * focus at), and continuous mode waits for a larger and longer change
  * before rescanning.
+ *
+ * The fine pass only measures two positions, fineRange on either side of
+ * the coarse peak, and the lens goes to the vertex of the parabola through
+ * the best measure and its two neighbours (in position order, over both
+ * passes): about half the measures of a fine grid, with a finer result.
  */
 
 #include "af.h"
@@ -47,14 +52,13 @@ int Af::init(IPAContext &context, const YamlObject &tuningData)
 {
 	settleFrames_ = tuningData["settleFrames"].get<unsigned int>(0);
 	coarseStep_ = tuningData["coarseStep"].get<double>(10.0);
-	fineStep_ = tuningData["fineStep"].get<double>(2.0);
-	fineRange_ = tuningData["fineRange"].get<double>(coarseStep_ / 2.0);
+	fineRange_ = tuningData["fineRange"].get<double>(coarseStep_ * 0.4);
 	rangeMin_ = std::clamp(tuningData["rangeMin"].get<double>(0.0), 0.0, 100.0);
 	rangeMax_ = std::clamp(tuningData["rangeMax"].get<double>(100.0), rangeMin_, 100.0);
 	peakDrop_ = tuningData["peakDrop"].get<double>(0.7);
 	peakDropSteps_ = tuningData["peakDropSteps"].get<unsigned int>(2);
 	changeThreshold_ = tuningData["changeThreshold"].get<double>(0.5);
-	changeFrames_ = tuningData["changeFrames"].get<unsigned int>(8);
+	changeFrames_ = tuningData["changeFrames"].get<unsigned int>(10);
 
 	context.ctrlMap[&controls::LensPosition] = ControlInfo(0.0f, 100.0f, 50.0f);
 	context.ctrlMap[&controls::AfMode] =
@@ -100,6 +104,7 @@ void Af::startScan(IPAContext &context)
 	af.minScore = INFINITY;
 	af.settle = settleFrames_ + 2;	/* the first move can be long */
 	af.changed = 0;
+	af.samples.clear();
 	af.state = controls::AfStateScanning;
 
 	LOG(IPASoftAutoFocus, Debug) << "Starting scan";
@@ -122,10 +127,41 @@ void Af::stopScan(IPAContext &context, bool found)
 		<< (found ? "" : ", no contrast peak");
 }
 
+/*
+ * Lens position of the focus peak: vertex of the parabola through the best
+ * measure and its neighbours, kept between the midpoints to the neighbours
+ * (the curve is not a parabola far from the peak).
+ */
+double Af::peakPosition(IPAContext &context)
+{
+	auto samples = context.activeState.af.samples;
+
+	std::sort(samples.begin(), samples.end());
+	auto best = std::max_element(samples.begin(), samples.end(),
+				     [](const auto &a, const auto &b) {
+					     return a.second < b.second;
+				     });
+	if (best == samples.begin() || best + 1 == samples.end())
+		return best->first;
+
+	double x0 = (best - 1)->first, y0 = (best - 1)->second;
+	double x1 = best->first, y1 = best->second;
+	double x2 = (best + 1)->first, y2 = (best + 1)->second;
+
+	double num = (x1 - x0) * (x1 - x0) * (y1 - y2) - (x1 - x2) * (x1 - x2) * (y1 - y0);
+	double den = (x1 - x0) * (y1 - y2) - (x1 - x2) * (y1 - y0);
+	if (!(den > 0.0) && !(den < 0.0))
+		return x1;
+
+	double x = x1 - 0.5 * num / den;
+	return std::clamp(x, (x0 + x1) / 2.0, (x1 + x2) / 2.0);
+}
+
 void Af::scanStep(IPAContext &context, double score)
 {
 	auto &af = context.activeState.af;
 
+	af.samples.emplace_back(af.position, score);
 	if (score > af.bestScore) {
 		af.bestScore = score;
 		af.bestPosition = af.position;
@@ -150,21 +186,26 @@ void Af::scanStep(IPAContext &context, double score)
 	}
 
 	if (!af.fine) {
-		/* Fine pass around the best coarse position */
+		/* Fine pass: fineRange on either side of the coarse peak */
 		af.fine = true;
-		/* Grid centred on the coarse peak, so that it is measured again */
-		double half = fineStep_ * std::floor(fineRange_ / fineStep_);
-		af.start = std::clamp(af.bestPosition - half, rangeMin_, rangeMax_);
-		af.stop = std::clamp(af.bestPosition + half, rangeMin_, rangeMax_);
-		af.step = fineStep_;
-		af.position = af.start;
-		af.bestScore = 0.0;
-		af.settle = settleFrames_ + 1;
-		return;
+		double lo = af.bestPosition - fineRange_;
+		double hi = af.bestPosition + fineRange_;
+		af.start = lo >= rangeMin_ - 1e-6 ? lo : hi;
+		af.stop = hi <= rangeMax_ + 1e-6 ? hi : lo;
+		af.step = std::max(hi - lo, 1.0);
+		if (af.start >= rangeMin_ - 1e-6 && af.stop <= rangeMax_ + 1e-6 &&
+		    af.start <= af.stop + 1e-6) {
+			af.position = af.start;
+			af.settle = settleFrames_ + 1;
+			return;
+		}
 	}
 
 	/* A flat curve has no focus peak (no texture, too dark) */
-	stopScan(context, af.bestScore > af.minScore * 1.15);
+	bool found = af.bestScore > af.minScore * 1.15;
+	if (found)
+		af.bestPosition = std::clamp(peakPosition(context), rangeMin_, rangeMax_);
+	stopScan(context, found);
 }
 
 void Af::monitor(IPAContext &context, double score)
