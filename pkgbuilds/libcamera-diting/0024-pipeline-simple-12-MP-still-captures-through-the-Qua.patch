From b1dafb4cc9f52f24f6d138cef5e01130ae56083b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 28 Nov 2026 11:55:07 +0300
Subject: [PATCH] pipeline: simple: 12 MP still captures through the Qualcomm
 BPS

With the BPS as converter, the StillCapture role got the largest output,
the 50 MP mode, which the BPS cannot process yet (no parameter block nor
striping): the configuration failed and applications fell back on a
viewfinder image. Keep still captures within kStreamMaxArea (4096 x 3072)
on that path.

The sensor keeps its exposure in lines across configurations, but a line
lasts 3.2 us in the 1080p mode of the S5KHP1 and 7 us in 4096 x 3072: the
still was overexposed. Keep the exposure time and the total gain instead,
written to the sensor before the stream starts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 86 +++++++++++++++++++++++-
 1 file changed, 83 insertions(+), 3 deletions(-)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index cb5b84b..f00f7d8 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -350,6 +350,14 @@ public:
 	bool bpsAfNeedRef_ = false;
 	int32_t bpsVblankMin_ = 0;
 	int32_t bpsExposureMargin_ = 0;
+	/*
+	 * Exposure time kept across configurations: the sensor keeps its
+	 * exposure in lines, whose duration differs between modes (3.2 us in
+	 * the 1080p mode of the S5KHP1, 7 us in 4096 x 3072).
+	 */
+	double bpsLineTime_ = 0.0;	/* seconds */
+	double bpsLastExposureTime_ = 0.0;
+	int32_t bpsLastGain_ = 0;
 
 	/*
 	 * White balance for the BPS: the parameter block of the driver
@@ -1159,6 +1167,7 @@ void SimpleCameraData::bpsAeStart()
 	 * exposure max = height + VBLANK - margin.
 	 */
 	bpsVblank_ = -1;
+	bpsLineTime_ = 0.0;
 	auto vb = infos.find(V4L2_CID_VBLANK);
 	auto hb = infos.find(V4L2_CID_HBLANK);
 	auto pr = infos.find(V4L2_CID_PIXEL_RATE);
@@ -1171,6 +1180,7 @@ void SimpleCameraData::bpsAeStart()
 				     t.get(V4L2_CID_HBLANK).get<int32_t>();
 		const int64_t rate = t.get(V4L2_CID_PIXEL_RATE).get<int64_t>();
 		const int32_t vblank = t.get(V4L2_CID_VBLANK).get<int32_t>();
+		bpsLineTime_ = rate > 0 ? static_cast<double>(line) / rate : 0.0;
 		const char *env = utils::secure_getenv("LIBCAMERA_QCOM_BPS_MIN_FPS");
 		const int fps = env ? std::atoi(env) : 60;
 		const int64_t lines = line > 0 && fps > 0 ? rate / (line * fps) : 0;
@@ -1191,6 +1201,36 @@ void SimpleCameraData::bpsAeStart()
 	bpsAeFrame_ = 0;
 	bpsAe_ = true;
 
+	/* Same exposure time and total gain as the previous configuration */
+	if (bpsLineTime_ > 0 && bpsLastExposureTime_ > 0 && bpsLastGain_ > 0) {
+		const double total = bpsLastExposureTime_ / bpsLineTime_ * bpsLastGain_;
+		int32_t exposure = std::clamp<int32_t>(std::lround(bpsLastExposureTime_ / bpsLineTime_),
+						       bpsExposureMin_, bpsExposureMax_);
+		int32_t g = std::clamp<int32_t>(std::lround(total / exposure),
+						bpsGainMin_, bpsGainMax_);
+		ControlList ctrls(sensor_->controls());
+		if (bpsVblank_ >= 0) {
+			const int32_t vblank = std::max(bpsVblankMin_,
+							exposure + bpsExposureMargin_ -
+							static_cast<int32_t>(bpsSensorSize_.height));
+			ctrls.set(V4L2_CID_VBLANK, vblank);
+			bpsVblank_ = vblank;
+		}
+		ctrls.set(V4L2_CID_EXPOSURE, exposure);
+		ctrls.set(V4L2_CID_ANALOGUE_GAIN, g);
+		sensor_->setControls(&ctrls);
+		LOG(SimplePipeline, Debug)
+			<< "BPS exposure loop: " << bpsLastExposureTime_ * 1e3
+			<< " ms kept, exposure " << bpsExposure_ << " -> " << exposure
+			<< ", gain " << bpsGain_ << " -> " << g;
+		bpsExposure_ = exposure;
+		bpsGain_ = g;
+	}
+	if (bpsLineTime_ > 0) {
+		bpsLastExposureTime_ = bpsExposure_ * bpsLineTime_;
+		bpsLastGain_ = bpsGain_;
+	}
+
 	LOG(SimplePipeline, Info)
 		<< "BPS exposure loop: exposure " << bpsExposureMin_ << "-"
 		<< bpsExposureMax_ << ", gain " << bpsGainMin_ << "-" << bpsGainMax_
@@ -1874,6 +1914,10 @@ void SimpleCameraData::bpsAeMeasure(const FrameBuffer *buffer)
 	ctrls.set(V4L2_CID_EXPOSURE, exposure);
 	ctrls.set(V4L2_CID_ANALOGUE_GAIN, gain);
 	setSensorControls(ctrls, ControlList());
+	if (bpsLineTime_ > 0) {
+		bpsLastExposureTime_ = exposure * bpsLineTime_;
+		bpsLastGain_ = gain;
+	}
 }
 
 void SimpleCameraData::conversionOutputDone(FrameBuffer *buffer)
@@ -2396,9 +2440,45 @@ SimplePipelineHandler::generateConfiguration(Camera *camera, Span<const StreamRo
 		StreamConfiguration cfg{ StreamFormats{ formats } };
 		cfg.pixelFormat = formats.begin()->first;
 		cfg.size = formats.begin()->second[0].max;
-		if (role != StreamRole::Raw && role != StreamRole::StillCapture &&
-		    !streamSize.isNull())
-			cfg.size = std::min(cfg.size, streamSize);
+		/*
+		 * A converter whose output is the input size (the Qualcomm BPS)
+		 * gives one range per sensor mode, which do not merge: take
+		 * the largest of all, not that of the first range.
+		 */
+		for (const SizeRange &range : formats.begin()->second) {
+			if (static_cast<uint64_t>(range.max.width) * range.max.height >
+			    static_cast<uint64_t>(cfg.size.width) * cfg.size.height)
+				cfg.size = range.max;
+		}
+		/*
+		 * With the Qualcomm BPS as converter, still captures too stay
+		 * within kStreamMaxArea: the BPS has parameter blocks and
+		 * striping up to 4096 x 3072, not for the 50 MP mode.
+		 */
+		const bool bps = data->converter_ && utils::secure_getenv("LIBCAMERA_QCOM_BPS");
+		if (role != StreamRole::Raw && (role != StreamRole::StillCapture || bps) &&
+		    !streamSize.isNull() &&
+		    static_cast<uint64_t>(cfg.size.width) * cfg.size.height >
+		    static_cast<uint64_t>(streamSize.width) * streamSize.height)
+			cfg.size = streamSize;
+		/*
+		 * BPS streaming roles: a full size mode (4096 x 3072 at 30 fps)
+		 * would slow the viewfinder down; keep the largest mode at most
+		 * 2048 pixels wide (1920 x 1080 for the S5KHP1, up to 120 fps).
+		 */
+		if (bps && role != StreamRole::Raw && role != StreamRole::StillCapture) {
+			Size small;
+			for (const SizeRange &range : formats.begin()->second) {
+				if (range.max.width <= 2048 &&
+				    static_cast<uint64_t>(range.max.width) * range.max.height >
+				    static_cast<uint64_t>(small.width) * small.height)
+					small = range.max;
+			}
+			if (!small.isNull())
+				cfg.size = small;
+		}
+		LOG(SimplePipeline, Debug)
+			<< "Default size for role " << role << ": " << cfg.size;
 
 		config->addConfiguration(cfg);
 	}
-- 
