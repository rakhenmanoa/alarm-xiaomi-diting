+	sharpX0_ = static_cast<unsigned int>(x * window_.width);
+	sharpX1_ = static_cast<unsigned int>((x + w) * window_.width);
+	sharpY0_ = static_cast<unsigned int>(y * window_.height);
+	sharpY1_ = static_cast<unsigned int>((y + h) * window_.height);
