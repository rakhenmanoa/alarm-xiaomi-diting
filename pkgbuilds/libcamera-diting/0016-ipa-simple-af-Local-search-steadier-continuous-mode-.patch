+	float w = focusWindow_[2], h = focusWindow_[3];
+
+	/* Anything unusable (not a number included): the centre third */
+	if (!(w > 0.0f && h > 0.0f && x >= 0.0f && y >= 0.0f &&
+	      x < 1.0f && y < 1.0f)) {
+		x = y = w = h = 1.0f / 3;
