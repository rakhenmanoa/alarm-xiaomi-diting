+/* A new measure at a position already measured replaces the old one */
+void Af::addSample(double position, double score)
+{
+	auto same = std::find_if(samples_.begin(), samples_.end(),
+				 [&](const Sample &sample) {
+					 return std::abs(sample.position - position) <= kSamePosition;
+				 });
+	if (same != samples_.end())
+		samples_.erase(same);
+
+	samples_.push_back({ position, score, steps_ });
+
+	bestScore_ = 0.0;
+	minScore_ = INFINITY;
+	for (const Sample &sample : samples_) {
+		if (sample.score > bestScore_) {
+			bestScore_ = sample.score;
+			bestPosition_ = sample.position;
+		}
+		minScore_ = std::min(minScore_, sample.score);
+	}
+}
