+/*
+ * The best measure and its neighbours in position, the three the result
+ * rests on. Null where the best measure has no neighbour.
+ */
+std::array<const Af::Sample *, 3> Af::peakSamples(std::vector<Sample> &sorted) const
+{
+	sorted = samples_;
+	std::sort(sorted.begin(), sorted.end(),
+		  [](const Sample &a, const Sample &b) { return a.position < b.position; });
+	auto best = std::max_element(sorted.begin(), sorted.end(),
+				     [](const Sample &a, const Sample &b) {
+					     return a.score < b.score;
+				     });
+	if (best == sorted.end())
+		return { { nullptr, nullptr, nullptr } };
+
+	return { { best == sorted.begin() ? nullptr : &*(best - 1), &*best,
+		   best + 1 == sorted.end() ? nullptr : &*(best + 1) } };
+}
