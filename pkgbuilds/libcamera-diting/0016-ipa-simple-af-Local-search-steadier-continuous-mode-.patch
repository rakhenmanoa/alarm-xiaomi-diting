+/*
+ * Next position of the fine pass: fineRange away from the best measure, on a
+ * side where nothing was measured that close. The nearest to the lens first.
+ */
+std::optional<double> Af::nextFinePosition(double current) const
+{
+	std::optional<double> next;
+
+	for (double side : { -1.0, 1.0 }) {
+		double target = bestPosition_ + side * fineRange_;
+		if (target < rangeMin_ - 1e-6 || target > rangeMax_ + 1e-6)
+			continue;
+
+		bool measured = std::any_of(samples_.begin(), samples_.end(),
+					    [&](const Sample &sample) {
+						    double d = side * (sample.position - bestPosition_);
+						    return d > kSamePosition && d <= fineRange_ + 1e-6;
+					    });
+		if (measured)
+			continue;
+
+		if (!next || std::abs(target - current) < std::abs(*next - current))
+			next = target;
+	}
+
+	return next;
