+/* Count the statistics in a row with the same measure and exposure */
+void Af::trackSteady(double score, double exposure)
+{
+	bool steady = prevScore_ > 0.0 && prevExposure_ > 0.0 &&
+		      std::abs(score - prevScore_) <= prevScore_ * stableThreshold_ &&
+		      std::abs(exposure - prevExposure_) <= prevExposure_ * 0.1;
+
+	stable_ = steady ? stable_ + 1 : 0;
+	prevScore_ = score;
+	prevExposure_ = exposure;
+}
