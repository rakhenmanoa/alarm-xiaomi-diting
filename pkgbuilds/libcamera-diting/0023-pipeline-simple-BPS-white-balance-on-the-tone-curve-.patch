From 1f9eaa9995ba9543bdcec92cb2687cfd3357fae2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 28 Nov 2026 11:41:24 +0300
Subject: [PATCH] pipeline: simple: BPS white balance on the tone curve of the
 block

The white balance linearised the BPS output with a fixed power 2.2 and a
black at 48. With another tone curve (sRGB, crushed black, S curve) or a
stronger chroma in the YUV conversion its measures were wrong: the gains
overshot and oscillated (colour flicker) and settled on a cast. Invert
the gamma table of the parameter block instead, divide the chroma by
the gain of the YUV conversion, and take damped steps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 61 +++++++++++++++++++++---
 1 file changed, 54 insertions(+), 7 deletions(-)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index d5b846d..cb5b84b 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -367,6 +367,14 @@ public:
 	bool bpsAwb_ = false;
 	/* Gains kept across restarts (a still capture restarts the camera) */
 	bool bpsWbKept_ = false;
+	/*
+	 * Inverse of the output tone curve (8-bit luma -> linear, from the
+	 * gamma table of the block) and the chroma gain of its YUV conversion,
+	 * so that the white balance measures linear colours whatever the
+	 * curve and the saturation of the block.
+	 */
+	std::array<double, 256> bpsLin_ = {};
+	double bpsChroma_ = 1.0;
 	std::array<double, 3> bpsWbLast_ = { 1.0, 1.0, 1.0 };
 
 	/*
@@ -1224,6 +1232,39 @@ void SimpleCameraData::bpsAwbLoad()
 	if (regsOff + regsLen > bpsParams_.size())
 		return;
 
+	/* Default output curve: power 2.2 with the black at 48 */
+	for (unsigned int k = 0; k < 256; k++)
+		bpsLin_[k] = std::pow(std::clamp((k - 48.0) / 207.0, 0.0, 1.0), 2.2);
+	bpsChroma_ = 1.0;
+
+	/* Gamma table (3 x 256 words, value in bits 0-11): invert the first one */
+	const uint32_t glutOff = u32(32), glutLen = u32(36);
+	if (glutLen >= 1024 && glutOff + glutLen <= bpsParams_.size()) {
+		std::array<double, 256> out;
+		for (unsigned int i = 0; i < 256; i++)
+			out[i] = (u32(glutOff + 4 * i) & 0xfff) / 4095.0;
+		unsigned int i = 0;
+		for (unsigned int k = 0; k < 256; k++) {
+			const double t = k / 255.0;
+			while (i < 254 && out[i + 1] < t)
+				i++;
+			const double d = out[i + 1] - out[i];
+			const double f = d > 0 ? std::clamp((t - out[i]) / d, 0.0, 1.0) : 0.0;
+			bpsLin_[k] = (i + f) / 255.0;
+		}
+	}
+
+	for (size_t off = regsOff; off + 8 <= regsOff + regsLen; off += 8) {
+		/* CST Cb row: coefficient of B (bits 16-28), 510 for BT.601 */
+		if (u32(off) != 0x5480)
+			continue;
+		int c = (u32(off + 4) >> 16) & 0x1fff;
+		if (c & 0x1000)
+			c -= 0x2000;
+		if (c > 0)
+			bpsChroma_ = c / 510.0;
+	}
+
 	/* White balance 2.0: gains for G, B, R at 0x3868, 0x386c, 0x3870 */
 	unsigned int found = 0;
 	for (size_t off = regsOff; off + 8 <= regsOff + regsLen; off += 8) {
@@ -1248,7 +1289,9 @@ void SimpleCameraData::bpsAwbLoad()
 		bpsAwbApply();
 	}
 	LOG(SimplePipeline, Info)
-		<< "BPS white balance: block of " << bpsParams_.size()
+		<< "BPS white balance: chroma " << bpsChroma_
+		<< ", luma 128 = linear " << bpsLin_[128]
+		<< ", block of " << bpsParams_.size()
 		<< " bytes, gains G " << bpsWbGains_[0] << " B " << bpsWbGains_[1]
 		<< " R " << bpsWbGains_[2];
 }
@@ -1740,9 +1783,12 @@ void SimpleCameraData::bpsAeMeasure(const FrameBuffer *buffer)
 	if (bpsAwb_ && map.planes().size() >= 2 &&
 	    map.planes()[1].size() >= static_cast<size_t>(stride) * height / 2) {
 		const uint8_t *uv = map.planes()[1].data();
-		auto lin = [](double v) {
-			return std::pow(std::clamp((v - 48.0) / 207.0, 0.0, 1.0), 2.2);
+		auto lin = [this](double v) {
+			v = std::clamp(v, 0.0, 255.0);
+			const unsigned int k = std::min(static_cast<unsigned int>(v), 254u);
+			return bpsLin_[k] + (v - k) * (bpsLin_[k + 1] - bpsLin_[k]);
 		};
+		const double chroma = 1.0 / bpsChroma_;
 		double sr = 0, sg = 0, sb = 0;
 		unsigned int n = 0;
 		for (unsigned int j = stepY / 2; j < height; j += stepY) {
@@ -1752,8 +1798,8 @@ void SimpleCameraData::bpsAeMeasure(const FrameBuffer *buffer)
 				const double Y = line[i];
 				if (Y < 70 || Y > 235)
 					continue;
-				const double U = cl[(i & ~1u)] - 128.0;
-				const double V = cl[(i & ~1u) + 1] - 128.0;
+				const double U = (cl[(i & ~1u)] - 128.0) * chroma;
+				const double V = (cl[(i & ~1u) + 1] - 128.0) * chroma;
 				sr += lin(Y + 1.402 * V);
 				sg += lin(Y - 0.344 * U - 0.714 * V);
 				sb += lin(Y + 1.772 * U);
@@ -1762,8 +1808,9 @@ void SimpleCameraData::bpsAeMeasure(const FrameBuffer *buffer)
 		}
 
 		if (n > count / 20 && sr > 0 && sb > 0) {
-			const double kb = std::clamp(std::sqrt(sg / sb), 0.8, 1.25);
-			const double kr = std::clamp(std::sqrt(sg / sr), 0.8, 1.25);
+			/* Damped steps: a sharp tone curve must not make it oscillate */
+			const double kb = std::clamp(std::pow(sg / sb, 0.35), 0.9, 1.1);
+			const double kr = std::clamp(std::pow(sg / sr, 0.35), 0.9, 1.1);
 			LOG(SimplePipeline, Debug)
 				<< "BPS white balance: R/G " << sr / sg << ", B/G " << sb / sg
 				<< " over " << n << " samples";
-- 
2.43.0

