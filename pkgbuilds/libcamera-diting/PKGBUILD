# libcamera 0.7.0 + patches diting (capteurs S5K4H7/S5KHP1, IMX596/GC02M1, mise au point du
# software ISP, autofocus par contraste). Les patches visent la 0.7.0 ;
# scripts/20-construire-paquets.sh ne remplace libcamera que si la version
# d'ALARM est une 0.7.x (même soname).
pkgname=libcamera-diting
_tag=v0.7.0
_ditingcommit=c68ff47db94792fb5fd608e98d1ae489c2e592b1
pkgver=0.7.0
pkgrel=10
pkgdesc="libcamera avec la prise en charge des caméras du Xiaomi diting"
arch=(aarch64)
url="https://libcamera.org"
license=(LGPL-2.1-or-later GPL-2.0-or-later)
depends=(gcc-libs glibc gnutls libyaml libelf libunwind libdrm systemd-libs
         gstreamer gst-plugins-base-libs)
makedepends=(git meson ninja python-jinja python-ply python-yaml pybind11 openssl)
provides=(libcamera=${pkgver} libcamera-ipa=${pkgver} libcamera-tools=${pkgver} gst-plugin-libcamera=${pkgver})
conflicts=(libcamera libcamera-ipa libcamera-tools gst-plugin-libcamera)
# pas de strip : il invaliderait la signature des modules IPA
options=(!strip !debug)
source=("libcamera::git+https://github.com/libcamera-org/libcamera.git#tag=${_tag}"
        "diting-ubuntu::git+https://github.com/royka1/diting-ubuntu.git#commit=${_ditingcommit}"
        0005-ipa-libipa-Add-Sony-IMX596-and-GalaxyCore-GC02M1-sen.patch
        0006-ipa-simple-Longer-exposures-in-low-light-proportiona.patch
        0007-libcamera-software_isp-Centre-weighted-focus-measure.patch
        0008-ipa-simple-af-Parabolic-peak-fit-statistics-every-ot.patch
        0009-software_isp-GPU-MHC-demosaic-and-sharpening-for-pac.patch
        0010-pipeline-simple-Default-streaming-roles-to-a-sensor-.patch
        0011-ipa-simple-Tunable-exposure-target-contrast-and-satu.patch
        0012-software_isp-Leave-saturated-samples-out-of-the-whit.patch
        0013-software_isp-Back-to-statistics-every-fourth-frame.patch)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd libcamera
  local p
  for p in "$srcdir"/diting-ubuntu/ubuntu-diting/packages/libcamera/*.patch; do
    echo "patch : ${p##*/}"
    patch -Np1 --no-backup-if-mismatch -s < "$p"
  done
  # frontale (IMX596) et macro (GC02M1)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0005-ipa-libipa-Add-Sony-IMX596-and-GalaxyCore-GC02M1-sen.patch"
  # exposition longue en basse lumière (VBLANK), AGC proportionnel, AF plus rapide
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0006-ipa-simple-Longer-exposures-in-low-light-proportiona.patch"
  # Mise au point : tiers central de l'image, hautes lumières saturées ignorées
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0007-libcamera-software_isp-Centre-weighted-focus-measure.patch"
  # Autofocus plus rapide : sommet de parabole, statistiques une image sur deux
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0008-ipa-simple-af-Parabolic-peak-fit-statistics-every-ot.patch"
  # Dématriçage Malvar-He-Cutler + netteté (GPU, Bayer compacté), AGC qui protège les hautes lumières
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0009-software_isp-GPU-MHC-demosaic-and-sharpening-for-pac.patch"
  # aperçu en 12 MP par défaut, 50 MP réservé aux photos (rôle StillCapture)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0010-pipeline-simple-Default-streaming-roles-to-a-sensor-.patch"
  # cible d'exposition, contraste et saturation réglables ; hautes lumières selon la balance des blancs
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0011-ipa-simple-Tunable-exposure-target-contrast-and-satu.patch"
  # balance des blancs sans les zones brûlées (dominante verte avec une fenêtre dans l'image)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0012-software_isp-Leave-saturated-samples-out-of-the-whit.patch"
  # statistiques de nouveau une image sur quatre (gain qui oscillait entre 4x et 64x)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0013-software_isp-Back-to-statistics-every-fourth-frame.patch"
}
build() {
  arch-meson libcamera build \
    -Dpipelines=simple,uvcvideo \
    -Dipas=simple \
    -Dgstreamer=enabled \
    -Dv4l2=enabled \
    -Dcam=enabled \
    -Dqcam=disabled \
    -Dlc-compliance=disabled \
    -Dtest=false \
    -Ddocumentation=disabled \
    -Dpycamera=disabled \
    -Dwerror=false
  meson compile -C build
}
package() {
  meson install -C build --destdir "$pkgdir"
}
