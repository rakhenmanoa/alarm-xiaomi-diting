# Plasma Mobile 6.8.1 + correction du tiroir des réglages rapides vide.
# Au démarrage, la largeur du panneau est brièvement négative : rowCount
# devient négatif (-280), pageSize aussi (-840), et PaginateModel annonce
# des lignes d'indices négatifs. La vue crée alors 840 tuiles sans réglage
# (5040 erreurs QuickSettings.qml:102-107) qui repoussent les vraies tuiles.
# Patch 0001 : taille de page bornée à 0 (QML et PaginateModel).
# Retour au paquet d'Arch : sudo pacman -S plasma-mobile
pkgname=plasma-mobile-diting
pkgver=6.8.1
pkgrel=2
pkgdesc="Plasma Mobile ${pkgver} avec correction du tiroir des réglages rapides vide (diting)"
arch=(aarch64)
url="https://invent.kde.org/plasma/plasma-mobile"
license=(GPL-2.0-or-later LGPL-2.0-or-later)
provides=("plasma-mobile=${pkgver}")
conflicts=(plasma-mobile)

# Mêmes dépendances que le paquet plasma-mobile installé (lues dans la base
# locale de pacman), pour que le remplacement ne change rien d'autre.
_deps_installees() {
  local d
  for d in /var/lib/pacman/local/plasma-mobile-[0-9]*/desc /var/lib/pacman/local/plasma-mobile-diting-[0-9]*/desc; do
    [ -f "$d" ] || continue
    awk '/^%DEPENDS%$/{f=1; next} /^$/{f=0} f' "$d"
    return
  done
}
depends=($(_deps_installees))
makedepends=(git extra-cmake-modules plasma-wayland-protocols wayland-protocols vulkan-headers)
source=("plasma-mobile::git+https://github.com/KDE/plasma-mobile.git#tag=v${pkgver}"
        0001-quicksettings-negative-page-size.patch)
sha256sums=('SKIP' 'SKIP')

prepare() {
  if [ ${#depends[@]} -eq 0 ]; then
    echo "dépendances de plasma-mobile introuvables dans /var/lib/pacman/local : installez d'abord plasma-mobile" >&2
    return 1
  fi
  cd plasma-mobile
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0001-quicksettings-negative-page-size.patch"
}

build() {
  # options des paquets KDE d'Arch (libexec dans /usr/lib)
  cmake -B build -S plasma-mobile \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
