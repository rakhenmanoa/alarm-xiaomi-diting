+    // diting : libérer la RAM de Waydroid à la fermeture d'une app (paquet diting-waydroid-ram)
+    property bool ramAvailable: false
+    property var ramApps: []
+
+    function ramRefresh(): void {
+        ramShell.connectSource("diting-waydroid-ram list")
+    }
+
+    function ramSet(packageName: string, on: bool): void {
+        if (!/^[A-Za-z0-9_.]+$/.test(packageName)) {
+            return
+        }
+        ramShell.connectSource("diting-waydroid-ram " + (on ? "on " : "off ") + packageName)
+    }
+
+    P5Support.DataSource {
+        id: ramShell
+        engine: "executable"
+        connectedSources: []
+
+        onNewData: (source, data) => {
+            disconnectSource(source)
+            if (source === "diting-waydroid-ram list") {
+                root.ramAvailable = data["exit code"] === 0
+                const found = []
+                for (const line of (data["stdout"] ?? "").split("\n")) {
+                    const m = line.match(/^\[x\]\s+(\S+)/)
+                    if (m) {
+                        found.push(m[1])
+                    }
+                }
+                root.ramApps = found
+            } else {
+                root.ramRefresh()
+            }
+        }
+    }
+
+    Component.onCompleted: ramRefresh()
+
     Timer {
         id: autoRefreshApplicationsTimer
         interval: 2000
