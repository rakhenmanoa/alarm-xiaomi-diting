--- /dev/null
+++ b/src/contents/ui/camera/FocusSelectStrip.qml
@@ -0,0 +1,111 @@
+// SPDX-FileCopyrightText: 2026 Fanasina Randriatsarafara
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: root
+
+    // Whether the component should be shown
+    required property bool shown
+
+    // Lens position to show the slider at when it appears (0..100)
+    required property real initialPosition
+
+    // When manual focus should be turned off, back to autofocus
+    signal autoRequested()
+
+    // When the user picked a lens position (0..100, 0 = infinity end)
+    signal focusPositionRequested(position: real)
+
+    implicitHeight: shown ? columnLayout.implicitHeight : 0
+    clip: true
+
+    Behavior on implicitHeight {
+        PropertyAnimation {
+            duration: Kirigami.Units.shortDuration
+            easing.type: Easing.InOutCubic
+        }
+    }
+
+    onShownChanged: {
+        if (shown) {
+            focusSlider.value = root.initialPosition;
+        }
+    }
+
+    ColumnLayout {
+        id: columnLayout
+        spacing: Kirigami.Units.smallSpacing
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.top: parent.top
+
+        Kirigami.Theme.inherit: false
+        Kirigami.Theme.colorSet: Kirigami.Theme.Complementary
+
+        QQC2.Label {
+            Layout.topMargin: Kirigami.Units.smallSpacing
+            Layout.fillWidth: true
+            text: i18n("Manual Focus")
+            horizontalAlignment: Text.AlignHCenter
+            font.weight: Font.Bold
+            font.pointSize: Kirigami.Theme.smallFont.pointSize
+            color: "white"
+        }
+
+        RowLayout {
+            Layout.fillWidth: true
+            Layout.leftMargin: Kirigami.Units.largeSpacing
+            Layout.rightMargin: Kirigami.Units.largeSpacing
+            Layout.bottomMargin: Kirigami.Units.smallSpacing
+            spacing: Kirigami.Units.largeSpacing
+
+            Kirigami.Icon {
+                source: 'crosshairs-symbolic'
+                color: "white"
+                Layout.preferredWidth: Kirigami.Units.iconSizes.small
+                Layout.preferredHeight: Kirigami.Units.iconSizes.small
+                QQC2.ToolTip.visible: nearMouseArea.containsMouse
+                QQC2.ToolTip.text: i18n("Near")
+                MouseArea { id: nearMouseArea; anchors.fill: parent; hoverEnabled: true }
+            }
+
+            QQC2.Slider {
+                id: focusSlider
+                Layout.fillWidth: true
+                from: 0
+                to: 100
+                stepSize: 1
+                value: root.initialPosition
+
+                onMoved: root.focusPositionRequested(value)
+            }
+
+            Kirigami.Icon {
+                source: 'view-hidden-symbolic' // distant/infinity-ish stand-in icon
+                color: "white"
+                Layout.preferredWidth: Kirigami.Units.iconSizes.small
+                Layout.preferredHeight: Kirigami.Units.iconSizes.small
+                QQC2.ToolTip.visible: farMouseArea.containsMouse
+                QQC2.ToolTip.text: i18n("Far")
+                MouseArea { id: farMouseArea; anchors.fill: parent; hoverEnabled: true }
+            }
+
+            QQC2.ToolButton {
+                icon.name: 'edit-undo-symbolic'
+                icon.color: "white"
+                display: QQC2.ToolButton.IconOnly
+                text: i18n("Back to autofocus")
+                onClicked: root.autoRequested()
+
+                QQC2.ToolTip.visible: down
+                QQC2.ToolTip.text: text
+            }
+        }
+    }
+}
diff --git a/src/plasmacamera.cpp b/src/plasmacamera.cpp
index f5f9589..eef3375 100644
--- a/src/plasmacamera.cpp
+++ b/src/plasmacamera.cpp
@@ -250,6 +250,39 @@ void PlasmaCamera::resetFocusPoint()
     Q_EMIT focusPointChanged();
 }
 
+bool PlasmaCamera::manualFocusAvailable() const
+{
+    return m_settings.canSetManualFocus();
+}
+
+bool PlasmaCamera::manualFocusSet() const
+{
+    return m_settings.manualFocusSet();
+}
+
+float PlasmaCamera::manualFocus() const
+{
+    return m_settings.getManualFocus();
+}
+
+void PlasmaCamera::setManualFocus(const float position)
+{
+    if (m_settings.canSetManualFocus() && m_settings.trySetManualFocus(position)) {
+        // A manual position takes over from a chosen subject
+        if (m_settings.afPointSet()) {
+            m_settings.unSetAfWindow();
+            Q_EMIT focusPointChanged();
+        }
+        Q_EMIT settingsChanged(m_settings);
+    }
+}
+
+void PlasmaCamera::resetManualFocus()
+{
+    m_settings.unSetManualFocus();
+    Q_EMIT settingsChanged(m_settings);
+}
+
 int PlasmaCamera::iso() const
 {
     return static_cast<int>(m_settings.getGain() * 100);
