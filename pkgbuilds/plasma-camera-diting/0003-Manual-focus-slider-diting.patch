+        }
+    }
+
     // TODO: implement the rest of the settings
 }
 
@@ -283,6 +303,9 @@ bool Settings::trySetAfPoint(const QPointF &point)
         return false;
     }
 
+    // A chosen subject takes over from a manually set lens position
+    unSetManualFocus();
+
     m_afWindowUseDefault = false;
     m_afWindow = true;
     m_afPoint = QPointF(std::clamp(point.x(), 0.0, 1.0), std::clamp(point.y(), 0.0, 1.0));
@@ -290,6 +313,39 @@ bool Settings::trySetAfPoint(const QPointF &point)
     return true;
 }
 
+// Manual focus
+bool Settings::canSetManualFocus() const
+{
+    return m_manualFocusAvailable;
+}
+
+bool Settings::trySetManualFocus(const float position)
+{
+    if (!canSetManualFocus() || position < 0.0f || position > 100.0f) {
+        return false;
+    }
+
+    m_manualFocus = true;
+    m_manualFocusPosition = position;
+
+    return true;
+}
+
+void Settings::unSetManualFocus()
+{
+    m_manualFocus = false;
+}
+
+bool Settings::manualFocusSet() const
+{
+    return m_manualFocus;
+}
+
+float Settings::getManualFocus() const
+{
+    return m_manualFocusPosition;
+}
+
 bool Settings::afPointSet() const
 {
     return m_afWindow;
