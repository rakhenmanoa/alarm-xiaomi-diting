 src/contents/ui/camera/CameraPage.qml         |   5 +
 src/contents/ui/camera/FocusSelectStrip.qml   | 111 ++++++++++++++++++
 src/plasmacamera.cpp                          |  33 ++++++
 src/plasmacamera.h                            |  20 ++++
 src/plasmacamera/settings.cpp                 |  56 +++++++++
 src/plasmacamera/settings.h                   |  16 +++
 src/resources.qrc                             |   1 +
 8 files changed, 276 insertions(+)
 create mode 100644 src/contents/ui/camera/FocusSelectStrip.qml

