From 8fd3a531acec7765b4bb2e61a19ee42f8976a46d Mon Sep 17 00:00:00 2001
From: alarm <alarm@localhost>
Date: Sat, 31 Oct 2026 13:23:42 +0300
Subject: [PATCH] Reduced viewfinder, full resolution still capture (diting)

---
 src/plasmacamera/worker.cpp | 100 +++++++++++++++++++++++++++++++-----
 src/plasmacamera/worker.h   |   3 ++
 2 files changed, 90 insertions(+), 13 deletions(-)

diff --git a/src/plasmacamera/worker.cpp b/src/plasmacamera/worker.cpp
index db11662..800e380 100644
--- a/src/plasmacamera/worker.cpp
+++ b/src/plasmacamera/worker.cpp
@@ -3,6 +3,8 @@
 
 #include "worker.h"
 
+#include <cmath>
+
 static const QMap<libcamera::PixelFormat, QImage::Format> NATIVE_FORMATS{
     {libcamera::formats::ABGR8888, QImage::Format_RGBX8888},
     {libcamera::formats::XBGR8888, QImage::Format_RGBX8888},
@@ -13,6 +15,16 @@ static const QMap<libcamera::PixelFormat, QImage::Format> NATIVE_FORMATS{
     {libcamera::formats::RGB565, QImage::Format_RGB16},
 };
 
+/*
+ * diting: the viewfinder runs at a reduced size (at most kViewfinderMaxWidth
+ * wide, same aspect ratio), and a photo reconfigures the camera for the
+ * StillCapture role (the full resolution), keeps the kStillFrames-th frame
+ * and goes back to the viewfinder. libcamera keeps the exposure, white
+ * balance and focus across the two configurations.
+ */
+static constexpr unsigned int kViewfinderMaxWidth = 2048;
+static constexpr int kStillFrames = 3;
+
 Worker::Worker() = default;
 
 Worker::~Worker() = default;
@@ -87,9 +99,35 @@ void Worker::unsetCamera()
 void Worker::capture()
 {
     m_stillCaptureFrames.clear();
+    m_stillFrame = 0;
+
+    if (m_state != State::Running) {
+        return;
+    }
+
+    switchConfiguration(true);
+
+    // Full resolution not possible (buffers): take the photo from the viewfinder
+    if (m_requests.empty()) {
+        qWarning() << "Still capture configuration failed, using the viewfinder";
+        unsetError();
+        switchConfiguration(false);
+    }
+
     setMode(CaptureMode::StillImage);
 }
 
+void Worker::switchConfiguration(bool still)
+{
+    setMode(CaptureMode::None);
+    stopViewFinder();
+    m_stillConfig = still;
+    startViewFinder();
+    if (!still) {
+        setMode(CaptureMode::ViewFinder);
+    }
+}
+
 void Worker::setSettings(const Settings& settings)
 {
     m_settings = settings;
@@ -195,22 +233,35 @@ void Worker::processRequestDataAndEmit()
     // Populates m_image
     processRequestData();
 
-    // Implement photo capture
+    // Implement photo capture: the kStillFrames-th frame of the still
+    // configuration (exposure and white balance settled), or the next
+    // viewfinder frame without it
     if (m_mode == CaptureMode::StillImage) {
-        const QMutexLocker lock(&m_stillCaptureFramesMutex);
-
-        if (m_stillCaptureFrames.length() >= 5) {
+        if (m_image.isNull() || ++m_stillFrame < (m_stillConfig ? kStillFrames : 1)) {
             return;
         }
 
-        // Add image to frames used for shot
-        m_stillCaptureFrames.enqueue(m_image.copy());
+        {
+            const QMutexLocker lock(&m_stillCaptureFramesMutex);
+            m_stillCaptureFrames.clear();
+            m_stillCaptureFrames.enqueue(m_image.copy());
+        }
+
+        setMode(CaptureMode::None);
+        Q_EMIT stillCaptureFrames(m_stillCaptureFrames);
 
-        // Once we reach 5 frames, emit the photo
-        if (m_stillCaptureFrames.length() == 5) {
+        if (m_stillConfig) {
+            QMetaObject::invokeMethod(this, [this]() {
+                switchConfiguration(false);
+            }, Qt::QueuedConnection);
+        } else {
             setMode(CaptureMode::ViewFinder);
-            Q_EMIT stillCaptureFrames(m_stillCaptureFrames);
         }
+        return;
+    }
+
+    if (m_mode != CaptureMode::ViewFinder) {
+        return;
     }
 
     // Emit view finder frame, m_image is moved for performance
@@ -270,7 +321,8 @@ void Worker::startViewFinder()
      * the Viewfinder config because it appears that the higher resource usage of StillCapture
      * makes app more unstable (it could also be related to the demands of restarting the camera)
      */
-    m_config = m_camera->generateConfiguration({libcamera::StreamRole::Viewfinder});
+    m_config = m_camera->generateConfiguration({m_stillConfig ? libcamera::StreamRole::StillCapture
+                                                              : libcamera::StreamRole::Viewfinder});
 
     configure();
 
@@ -301,11 +353,11 @@ void Worker::stopViewFinder()
     m_framePollTimer->stop();
 
     if (m_camera) {
-        // All pending requests are cancelled
+        // All pending requests are cancelled. A camera that failed to
+        // start (still configuration without buffers) is cleaned up too.
         int ret = m_camera->stop();
         if (ret < 0) {
-            setError(ret);
-            return;
+            qWarning() << "Camera stop failed:" << ret;
         }
 
         // Cleanup signals
@@ -466,6 +518,28 @@ void Worker::configure()
         }
     }
 
+    // Viewfinder: reduced size, same aspect ratio as the default, only for
+    // cameras larger than that. Widths are kept to multiples of 64 pixels:
+    // the GPU cannot import some other output buffers (1400x1050 on the
+    // diting macro camera: eglCreateImageKHR fails)
+    if (!m_stillConfig && streamConfig.size.width > kViewfinderMaxWidth) {
+        const libcamera::Size def = streamConfig.size;
+        libcamera::Size best;
+        for (const libcamera::Size &size : streamConfig.formats().sizes(streamConfig.pixelFormat)) {
+            const double a = static_cast<double>(size.width) * def.height;
+            const double b = static_cast<double>(size.height) * def.width;
+            if (size.width > kViewfinderMaxWidth || size.width % 64 || std::abs(a - b) > 0.02 * a) {
+                continue;
+            }
+            if (static_cast<uint64_t>(size.width) * size.height > static_cast<uint64_t>(best.width) * best.height) {
+                best = size;
+            }
+        }
+        if (!best.isNull()) {
+            streamConfig.size = best;
+        }
+    }
+
     // TODO: allow user to override config
     //  - https://git.libcamera.org/libcamera/libcamera.git/tree/src/apps/qcam/main_window.cpp#n399
 
diff --git a/src/plasmacamera/worker.h b/src/plasmacamera/worker.h
index f2e92c7..5b57703 100644
--- a/src/plasmacamera/worker.h
+++ b/src/plasmacamera/worker.h
@@ -100,6 +100,7 @@ private:
 
     void startViewFinder();
     void stopViewFinder();
+    void switchConfiguration(bool still); // viewfinder <-> still capture
 
     void setState(State state);
     void setMode(CaptureMode mode);
@@ -143,6 +144,8 @@ private:
     // Queue of images for capturing a photo
     QMutex m_stillCaptureFramesMutex;
     QQueue<QImage> m_stillCaptureFrames;
+    bool m_stillConfig = false; // camera configured for the StillCapture role
+    int m_stillFrame = 0;
 
     libcamera::Stream *m_stream{};
     libcamera::FrameBufferAllocator *m_allocator{};
-- 
2.43.0

