From 43f4d12a59be4176dbadbbaecf3a481f5cb32169 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 08:37:44 +0300
Subject: [PATCH] Tap to focus (diting)

Tap on the viewfinder to focus on a subject (AfMetering/AfWindows), press
and hold to go back to the automatic choice.
---
 src/contents/ui/camera/Viewfinder.qml | 49 ++++++++++++++++++++++
 src/plasmacamera.cpp                  | 59 +++++++++++++++++++++++++++
 src/plasmacamera.h                    | 30 ++++++++++++++
 src/plasmacamera/settings.cpp         | 51 +++++++++++++++++++++--
 src/plasmacamera/settings.h           | 13 ++++++
 5 files changed, 199 insertions(+), 3 deletions(-)

diff --git a/src/contents/ui/camera/Viewfinder.qml b/src/contents/ui/camera/Viewfinder.qml
index 405c20e..b646b8b 100644
--- a/src/contents/ui/camera/Viewfinder.qml
+++ b/src/contents/ui/camera/Viewfinder.qml
@@ -34,5 +34,54 @@ Rectangle {
         visible: root.camera.available
         width: parent.width
         height: parent.height
+
+        // Tap to focus on a subject, press and hold to go back to the
+        // automatic choice (centre of the image)
+        MouseArea {
+            anchors.fill: parent
+            enabled: root.camera.available && root.camera.focusPointAvailable
+
+            onClicked: (mouse) => {
+                const rect = viewfinder.contentRect;
+                if (rect.width <= 0 || rect.height <= 0) {
+                    return;
+                }
+                root.camera.focusAt((mouse.x - rect.x) / rect.width, (mouse.y - rect.y) / rect.height);
+                focusMark.flash();
+            }
+            onPressAndHold: root.camera.resetFocusPoint()
+        }
+
+        // Where the focus was asked
+        Rectangle {
+            id: focusMark
+
+            function flash() {
+                focusMarkAnimation.restart();
+            }
+
+            visible: root.camera.available && root.camera.focusPointSet
+            x: viewfinder.contentRect.x + root.camera.focusPoint.x * viewfinder.contentRect.width - width / 2
+            y: viewfinder.contentRect.y + root.camera.focusPoint.y * viewfinder.contentRect.height - height / 2
+            width: Kirigami.Units.gridUnit * 4
+            height: width
+            radius: Kirigami.Units.cornerRadius
+
+            color: "transparent"
+            border.color: "white"
+            border.width: 2
+            opacity: 0.5
+
+            SequentialAnimation {
+                id: focusMarkAnimation
+
+                ParallelAnimation {
+                    NumberAnimation { target: focusMark; property: "scale"; from: 1.4; to: 1.0; duration: Kirigami.Units.longDuration; easing.type: Easing.OutCubic }
+                    NumberAnimation { target: focusMark; property: "opacity"; from: 1.0; to: 1.0; duration: Kirigami.Units.longDuration }
+                }
+                PauseAnimation { duration: 1200 }
+                NumberAnimation { target: focusMark; property: "opacity"; to: 0.5; duration: Kirigami.Units.longDuration }
+            }
+        }
     }
 }
\ No newline at end of file
diff --git a/src/plasmacamera.cpp b/src/plasmacamera.cpp
index c67502c..f5f9589 100644
--- a/src/plasmacamera.cpp
+++ b/src/plasmacamera.cpp
@@ -192,6 +192,64 @@ QSize PlasmaCamera::afWindow() const
     return m_settings.getAfWindow();
 }
 
+bool PlasmaCamera::focusPointAvailable() const
+{
+    return m_settings.canSetAfWindow();
+}
+
+bool PlasmaCamera::focusPointSet() const
+{
+    return m_settings.afPointSet();
+}
+
+QPointF PlasmaCamera::focusPoint() const
+{
+    return m_focusPoint;
+}
+
+void PlasmaCamera::focusAt(const qreal x, const qreal y)
+{
+    if (x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0) {
+        return;
+    }
+
+    // From the displayed image back to the image of the sensor: undo the
+    // mirroring, then the clockwise rotation of the display
+    const qreal u = m_mirrorOutput ? 1.0 - x : x;
+    QPointF point;
+    switch (m_softwareRotationDegrees) {
+    case 90:
+        point = QPointF(y, 1.0 - u);
+        break;
+    case 180:
+        point = QPointF(1.0 - u, 1.0 - y);
+        break;
+    case 270:
+        point = QPointF(1.0 - y, u);
+        break;
+    default:
+        point = QPointF(u, y);
+        break;
+    }
+
+    if (m_settings.trySetAfPoint(point)) {
+        m_focusPoint = QPointF(x, y);
+        Q_EMIT settingsChanged(m_settings);
+        Q_EMIT focusPointChanged();
+    }
+}
+
+void PlasmaCamera::resetFocusPoint()
+{
+    if (!m_settings.afPointSet()) {
+        return;
+    }
+
+    m_settings.unSetAfWindow();
+    Q_EMIT settingsChanged(m_settings);
+    Q_EMIT focusPointChanged();
+}
+
 int PlasmaCamera::iso() const
 {
     return static_cast<int>(m_settings.getGain() * 100);
@@ -606,6 +664,7 @@ bool PlasmaCamera::acquire()
     // m_camera->controls() is constant through the lifetime of m_camera, so we don't need to reload.
     m_settings.load(m_camera->controls());
     Q_EMIT settingsChanged(m_settings);
+    Q_EMIT focusPointChanged();
 
     // Find the amount of degrees needed to rotate the camera output by and populate m_softwareRotationDegrees
     std::optional<int> cameraRotation = m_camera->properties().get(libcamera::properties::Rotation);
