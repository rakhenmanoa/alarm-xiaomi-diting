         case libcamera::controls::AF_WINDOWS:
-            // TODO: should we check for AF_METERING instead?
-            // TODO: how to convert Span<const Rectangle> to QSize?
-            m_afWindowAvailable = true;
+            // The upper limit of the control is the rectangle the windows are
+            // expressed in (libcamera-diting: 1/10000 of the image)
+            if (controlInfo.max().type() == libcamera::ControlTypeRectangle && !controlInfo.max().isArray()) {
+                m_afWindowSpace = controlInfo.max().get<libcamera::Rectangle>();
+            }
+            m_afWindowAvailable = m_afWindowSpace.width > 0 && m_afWindowSpace.height > 0;
+            break;
+
+        case libcamera::controls::AF_METERING:
+            m_afMeteringAvailable = true;
             break;
 
         case libcamera::controls::AWB_MODE:
@@ -117,6 +126,24 @@ void Settings::set(libcamera::ControlList &controlMap)
         controlMap.set(libcamera::controls::ExposureTime, m_exposureTime);
     }
 
+    if (m_afWindowAvailable && m_afMeteringAvailable) {
+        if (m_afWindow) {
+            // Focus window around the point chosen by the user
+            const double side = 0.18;
+            const double x = std::clamp(m_afPoint.x() - side / 2, 0.0, 1.0 - side);
+            const double y = std::clamp(m_afPoint.y() - side / 2, 0.0, 1.0 - side);
+            const libcamera::Rectangle window(m_afWindowSpace.x + static_cast<int>(x * m_afWindowSpace.width),
+                                              m_afWindowSpace.y + static_cast<int>(y * m_afWindowSpace.height),
+                                              static_cast<unsigned int>(side * m_afWindowSpace.width),
+                                              static_cast<unsigned int>(side * m_afWindowSpace.height));
+
+            controlMap.set(libcamera::controls::AfMetering, libcamera::controls::AfMeteringWindows);
+            controlMap.set(libcamera::controls::AfWindows, libcamera::Span<const libcamera::Rectangle>(&window, 1));
+        } else {
+            controlMap.set(libcamera::controls::AfMetering, libcamera::controls::AfMeteringAuto);
+        }
+    }
+
     // TODO: implement the rest of the settings
 }
 
@@ -250,6 +277,24 @@ void Settings::unSetAfWindow()
     m_afWindow = false;
 }
 
+bool Settings::trySetAfPoint(const QPointF &point)
+{
+    if (!canSetAfWindow()) {
+        return false;
+    }
+
+    m_afWindowUseDefault = false;
+    m_afWindow = true;
+    m_afPoint = QPointF(std::clamp(point.x(), 0.0, 1.0), std::clamp(point.y(), 0.0, 1.0));
+
+    return true;
+}
+
+bool Settings::afPointSet() const
+{
+    return m_afWindow;
+}
+
 QSize Settings::getAfWindow() const
 {
     if (m_afWindowUseDefault) {
