diff --git a/src/libssc-sensor.c b/src/libssc-sensor.c
index 5947dba..f01f44f 100644
--- a/src/libssc-sensor.c
+++ b/src/libssc-sensor.c
@@ -230,11 +230,13 @@ sensor_open (SSCSensor *self, GCancellable *cancellable, GAsyncReadyCallback cal
 	/*
 	 * Sensors which support on-change do not need any configuration,
 	 * only a different message ID to enable them.
+	 *
+	 * Gesture sensors (tilt to wake...) report a single-output or event
+	 * stream type; they are enabled like on-change sensors.
 	 */
