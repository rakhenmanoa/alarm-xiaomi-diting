diff --git a/src/libssc-sensor-tilt-to-wake.c b/src/libssc-sensor-tilt-to-wake.c
new file mode 100644
index 0000000..4d9ef6c
--- /dev/null
+++ b/src/libssc-sensor-tilt-to-wake.c
@@ -0,0 +1,304 @@
+/*
+ * libssc: Library to expose Qualcomm Sensor Core sensors
+ * Copyright (C) 2026 libssc contributors (based on the proximity sensor by Dylan Van Assche)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published
+ * by the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program. If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Tilt to wake: a gesture sensor of the Sensor Core (Qualcomm's
+ * sns_tilt_to_wake algorithm, fed by the accelerometer on the DSP).
+ * It reports one event each time the device is raised towards the user;
+ * the events are delivered with wake-up, so they also arrive while the
+ * application processor is suspended.
+ *
+ * The "detected" signal carries the first event value (0 if the event
+ * has no value) and the message id it came with, for debugging.
+ */
+
+#include "ssc-common.pb-c.h"
+#include "ssc-sensor-event.pb-c.h"
+#include "libssc-client-private.h"
+#include "libssc-common-private.h"
+#include "libssc-sensor-tilt-to-wake.h"
+
+enum {
+	SIGNAL_DETECTED,
+	N_SIGNALS
+};
+static guint signals[N_SIGNALS];
+
+typedef struct _SSCSensorTiltToWakePrivate {
+	guint report_id;
+} SSCSensorTiltToWakePrivate;
+
+G_DEFINE_TYPE_WITH_CODE (SSCSensorTiltToWake, ssc_sensor_tilt_to_wake, SSC_TYPE_SENSOR,
+			 G_ADD_PRIVATE (SSCSensorTiltToWake))
+
+typedef struct {
+	SSCSensorTiltToWake *sensor;
+	gfloat value;
+	guint msg_id;
+} SignalContext;
+
+static void
+signal_context_free (SignalContext *ctx)
+{
+	g_slice_free (SignalContext, ctx);
+}
+
+/*****************************************************************************/
+
+static gboolean
+emit_signal (gpointer user_data) {
+	SignalContext *ctx = user_data;
+
+	g_signal_emit (ctx->sensor, signals[SIGNAL_DETECTED], 0, ctx->value, ctx->msg_id);
+
+	return G_SOURCE_REMOVE;
+}
+
+static void
+report_received (SSCClient *self, guint32 msg_id, guint64 uid_high, guint64 uid_low, GArray *buf, gpointer user_data)
+{
+	SSCSensorTiltToWake *sensor = SSC_SENSOR_TILT_TO_WAKE (user_data);
+	SignalContext *ctx = NULL;
+	guint64 sensor_uid_low;
+	guint64 sensor_uid_high;
+	gfloat value = 0.0;
+
+	g_object_get (SSC_SENSOR (sensor),
+		      SSC_SENSOR_UID_HIGH, &sensor_uid_high,
+		      SSC_SENSOR_UID_LOW, &sensor_uid_low,
+		      NULL);
+
+	if (sensor_uid_high != uid_high || sensor_uid_low != uid_low)
+		return;
+
+	/* Configuration and attribute responses are not events */
+	if (msg_id == SSC_MSG_RESPONSE_ENABLE_REPORT || msg_id == SSC_MSG_RESPONSE_GET_ATTRIBUTES)
+		return;
+
+	if (msg_id == SSC_MSG_REPORT_MEASUREMENT) {
+		SscEventResponse *msg = ssc_event_response__unpack (NULL, buf->len, (const uint8_t *) buf->data);
+
+		if (msg) {
+			if (msg->n_data > 0)
+				value = msg->data[0];
+			g_debug ("Tilt to wake event: %zu value(s), first %f", msg->n_data, value);
+			ssc_event_response__free_unpacked (msg, NULL);
+		} else {
+			g_debug ("Tilt to wake event without the standard event payload");
+		}
+	} else if (msg_id < SSC_MSG_REPORT_MEASUREMENT_PROXIMITY) {
+		/* Requests and their responses, not events */
+		return;
+	} else {
+		g_debug ("Tilt to wake: message %u treated as an event", msg_id);
+	}
+
+	/* Emit signal in main context instead of thread's context */
+	ctx = g_slice_new0 (SignalContext);
+	ctx->sensor = sensor;
+	ctx->value = value;
+	ctx->msg_id = msg_id;
+	g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, emit_signal, ctx, (GDestroyNotify)signal_context_free);
+}
+
+/*****************************************************************************/
+
+static void
+tilt_to_wake_close_ready (SSCSensor *sensor, GAsyncResult *result, gpointer user_data)
+{
+	g_autoptr (GTask) task = G_TASK (user_data);
+	g_autoptr (GError) error = NULL;
+
+	if (!SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->close_finish (sensor, result, &error)) {
+		g_task_return_error (task, g_steal_pointer (&error));
+		return;
+	}
+
+	g_task_return_boolean (task, TRUE);
+}
+
+gboolean
+ssc_sensor_tilt_to_wake_close_finish (SSCSensorTiltToWake *self, GAsyncResult *result, GError **error)
+{
+	return g_task_propagate_boolean (G_TASK (result), error);
+}
+
+void
+ssc_sensor_tilt_to_wake_close (SSCSensorTiltToWake *self, GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+	GTask *task = NULL;
+	SSCClient *client = NULL;
+	SSCSensorTiltToWakePrivate *priv = NULL;
+
+	g_assert (SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->close &&
+		  SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->close_finish);
+
+	task = g_task_new (self, cancellable, callback, user_data);
+	priv = ssc_sensor_tilt_to_wake_get_instance_private (self);
+
+	/* Stop listening for reports */
+	g_object_get (SSC_SENSOR (self),
+		      SSC_SENSOR_CLIENT, &client,
+		      NULL);
+	if (priv->report_id)
+		g_signal_handler_disconnect (client, priv->report_id);
+	priv->report_id = 0;
+
+	/* Close sensor */
+	SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->close (SSC_SENSOR (self), cancellable, (GAsyncReadyCallback)tilt_to_wake_close_ready, task);
+}
+
+gboolean
+ssc_sensor_tilt_to_wake_close_sync (SSCSensorTiltToWake *self, GCancellable *cancellable, GError **error)
+{
+	gboolean success = FALSE;
+	SyncContext ctx;
+
+	ssc_common_init_sync_context (&ctx);
+	ssc_sensor_tilt_to_wake_close (self, cancellable, ssc_common_callback_sync_context, &ctx);
+	ssc_common_wait_sync_context (&ctx);
+	success = ssc_sensor_tilt_to_wake_close_finish (self, ctx.result, error);
+	ssc_common_clear_sync_context (&ctx);
+
+	return success;
+}
+
+/*****************************************************************************/
+
+static void
+tilt_to_wake_open_ready (SSCSensor *sensor, GAsyncResult *result, gpointer user_data)
+{
+	g_autoptr (GTask) task = G_TASK (user_data);
+	g_autoptr (GError) error = NULL;
+
+	if (!SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->open_finish (sensor, result, &error)) {
+		g_task_return_error (task, g_steal_pointer (&error));
+		return;
+	}
+
+	g_task_return_boolean (task, TRUE);
+}
+
+gboolean
+ssc_sensor_tilt_to_wake_open_finish (SSCSensorTiltToWake *self, GAsyncResult *result, GError **error)
+{
+	return g_task_propagate_boolean (G_TASK (result), error);
+}
+
+void
+ssc_sensor_tilt_to_wake_open (SSCSensorTiltToWake *self, GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+	SSCClient *client = NULL;
+	SSCSensorTiltToWakePrivate *priv = NULL;
+	GTask *task = NULL;
+
+	g_assert (SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->open &&
+		  SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->open_finish);
+
+	priv = ssc_sensor_tilt_to_wake_get_instance_private (self);
+	task = g_task_new (self, cancellable, callback, user_data);
+
+	/* Start listening for reports before opening the sensor */
+	g_object_get (SSC_SENSOR (self),
+		      SSC_SENSOR_CLIENT, &client,
+		      NULL);
+	priv->report_id = g_signal_connect (client,
+					    "report",
+					    G_CALLBACK (report_received),
+					    self);
+
+	/* Open sensor */
+	SSC_SENSOR_CLASS (ssc_sensor_tilt_to_wake_parent_class)->open (SSC_SENSOR (self), cancellable, (GAsyncReadyCallback)tilt_to_wake_open_ready, task);
+}
+
+gboolean
+ssc_sensor_tilt_to_wake_open_sync (SSCSensorTiltToWake *self, GCancellable *cancellable, GError **error)
+{
+	gboolean success = FALSE;
+	SyncContext ctx;
+
+	ssc_common_init_sync_context (&ctx);
+	ssc_sensor_tilt_to_wake_open (self, cancellable, ssc_common_callback_sync_context, &ctx);
+	ssc_common_wait_sync_context (&ctx);
+	success = ssc_sensor_tilt_to_wake_open_finish (self, ctx.result, error);
+	ssc_common_clear_sync_context (&ctx);
+
+	return success;
+}
+
+/*****************************************************************************/
+
+static void
+ssc_sensor_tilt_to_wake_class_init (SSCSensorTiltToWakeClass *klass)
+{
+	signals[SIGNAL_DETECTED] = g_signal_new ("detected",
+		G_TYPE_FROM_CLASS (klass),
+		G_SIGNAL_RUN_FIRST,
+		0, NULL, NULL, NULL,
+		G_TYPE_NONE,
+		2, G_TYPE_FLOAT, G_TYPE_UINT);
+}
+
+static void
+ssc_sensor_tilt_to_wake_init (SSCSensorTiltToWake *self)
+{
+}
+
+SSCSensorTiltToWake *
+ssc_sensor_tilt_to_wake_new_finish (GAsyncResult *result, GError **error)
+{
+	GObject *sensor;
+	GObject *source;
+
+	source = g_async_result_get_source_object (result);
+	sensor = g_async_initable_new_finish (G_ASYNC_INITABLE (source), result, error);
+	g_object_unref (source);
+
+	if (!sensor)
+		return NULL;
+
+	return SSC_SENSOR_TILT_TO_WAKE (sensor);
+}
+
+void
+ssc_sensor_tilt_to_wake_new (GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data)
+{
+	g_async_initable_new_async (
+			SSC_TYPE_SENSOR_TILT_TO_WAKE,
+			G_PRIORITY_DEFAULT,
+			cancellable,
+			callback,
+			user_data,
+			SSC_SENSOR_DATA_TYPE, "tilt_to_wake",
+			NULL);
+}
+
+SSCSensorTiltToWake *
+ssc_sensor_tilt_to_wake_new_sync (GCancellable *cancellable, GError **error)
+{
+	SSCSensorTiltToWake *self = NULL;
+	SyncContext ctx;
+
+	ssc_common_init_sync_context (&ctx);
+	ssc_sensor_tilt_to_wake_new (cancellable, ssc_common_callback_sync_context, &ctx);
+	ssc_common_wait_sync_context (&ctx);
+	self = ssc_sensor_tilt_to_wake_new_finish (ctx.result, error);
+	ssc_common_clear_sync_context (&ctx);
+
+	return self;
+}
