#!/bin/bash
# Aide root de diting-waydroid-ram (appelée via sudo, voir sudoers).
#   wait <paquet>    attend que l'app n'ait plus de fenêtre, puis libère la RAM
#   check <paquet>   affiche open/closed (pour tester la détection)
#   reclaim          libère la RAM de Waydroid tout de suite
set -u
CG="${DITING_WAYDROID_CG:-/sys/fs/cgroup/lxc.payload.waydroid/memory.reclaim}"
RECLAIM="${DITING_WAYDROID_RECLAIM:-1G swappiness=200}"

valide() { [[ "${1:-}" =~ ^[A-Za-z0-9_.]+$ ]] || { echo "nom de paquet invalide" >&2; exit 2; }; }

# l'app a-t-elle une fenêtre dans Android ?
ouverte() { waydroid shell dumpsys window windows 2>/dev/null | grep -q -E "Window\{[^}]* $1/"; }

reclaim() {
  [ -w "$CG" ] || { echo "cgroup introuvable : $CG" >&2; return 1; }
  # le noyau renvoie une erreur s'il ne peut pas tout libérer : sans gravité
  echo "$RECLAIM" > "$CG" 2>/dev/null || true
}

case "${1:-}" in
  check) valide "${2:-}"; ouverte "$2" && echo open || echo closed ;;
  reclaim) reclaim ;;
  wait)
    valide "${2:-}"
    # laisse 30 s à l'app pour ouvrir sa fenêtre
    vu=0
    for _ in $(seq 30); do ouverte "$2" && { vu=1; break; }; sleep 1; done
    [ "$vu" = 1 ] || exit 0
    # fermée = 2 contrôles de suite sans fenêtre (évite un faux positif en changeant d'écran)
    while :; do
      if ouverte "$2"; then sleep 3; continue; fi
      sleep 2
      ouverte "$2" || break
    done
    sleep 3
    reclaim ;;
  *) echo "usage : $0 wait|check <paquet> | reclaim" >&2; exit 1 ;;
esac
