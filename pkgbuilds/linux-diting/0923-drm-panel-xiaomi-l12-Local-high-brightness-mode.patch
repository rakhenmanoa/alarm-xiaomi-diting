From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fanasina RANDRIATSARAFARA <m.randriatsarafara.f@gmail.com>
Date: Thu, 5 Nov 2026 16:00:00 +0300
Subject: [PATCH] drm/panel: xiaomi-l12: Local high brightness mode

The 42 02 0a panel can light a small disc far above its normal range
under the optical fingerprint sensor ("local HBM"), which the sensor
needs to see a finger through the OLED. Add a local_hbm attribute to
the panel device: 0 off, 1 white 1000 nit, 2 white 110 nit, 3 green
500 nit, using the vendor DT sequences.
---
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-l12-36-02-0b.c b/drivers/gpu/drm/panel/panel-xiaomi-l12-36-02-0b.c
--- a/drivers/gpu/drm/panel/panel-xiaomi-l12-36-02-0b.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-l12-36-02-0b.c
@@ -758,6 +758,111 @@
 	return ret < 0 ? ret : 0;
 }
 
+/*
+ * Local high brightness mode (42 02 0a): a small disc driven far above the
+ * normal range, under the optical fingerprint sensor, which the sensor
+ * needs to see the finger. Sequences from the vendor DT
+ * (mi,mdss-dsi-local-hbm-normal-*-command and ...-off-to-normal-command),
+ * sent in high-speed mode like the vendor. The disc is centred at
+ * x = 610, y = 2444 (register 0x88), the sensor position.
+ *
+ * Written through the local_hbm file of the panel device:
+ *   0 off, 1 white 1000 nit, 2 white 110 nit, 3 green 500 nit.
+ * Keep it on only for a capture: it is very bright and wears the OLED.
+ */
+static const u8 xiaomi_l12_lhbm_gamma[][6] = {
+	[1] = { 0x09, 0x6a, 0x08, 0x3d, 0x0a, 0x18 },	/* white 1000 nit */
+	[2] = { 0x06, 0x13, 0x05, 0x60, 0x06, 0x8f },	/* white 110 nit */
+	[3] = { 0x00, 0x00, 0x07, 0xf1, 0x00, 0x00 },	/* green 500 nit */
+};
+
+static int xiaomi_l12_42_local_hbm(struct xiaomi_l12 *ctx, unsigned int mode)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct mipi_dsi_device *dsi = ctx->dsi;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	if (mode) {
+		u8 d0[7] = { 0xd0 };
+
+		memcpy(&d0[1], xiaomi_l12_lhbm_gamma[mode], 6);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x17);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x07, 0xff);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x1f);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x00, 0x50);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd1, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x08);
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, d0, sizeof(d0));
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x07);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd9, 0x40);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc0, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x51, 0x07, 0xff);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x88, 0x02, 0x62, 0x09, 0x8c);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x87, 0x11, 0x11);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x88, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x85, 0x01);
+	} else {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x20);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x87, 0x0f, 0xff);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x88, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x86, 0x01);
+	}
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	/* Back to the user's brightness (the vendor resends DBV here too). */
+	if (!mode && ctx->panel.backlight)
+		return backlight_update_status(ctx->panel.backlight);
+
+	return 0;
+}
+
+static unsigned int xiaomi_l12_lhbm_state;
+
+static ssize_t local_hbm_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", xiaomi_l12_lhbm_state);
+}
+
+static ssize_t local_hbm_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct xiaomi_l12 *ctx = mipi_dsi_get_drvdata(to_mipi_dsi_device(dev));
+	unsigned int mode;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &mode);
+	if (ret)
+		return ret;
+	if (mode >= ARRAY_SIZE(xiaomi_l12_lhbm_gamma))
+		return -EINVAL;
+	if (ctx->desc->set_rate != xiaomi_l12_42_set_rate)	/* 42 02 0a only */
+		return -EOPNOTSUPP;
+	if (!ctx->panel.prepared)
+		return -EAGAIN;
+
+	ret = xiaomi_l12_42_local_hbm(ctx, mode);
+	if (ret)
+		return ret;
+	xiaomi_l12_lhbm_state = mode;
+
+	return count;
+}
+static DEVICE_ATTR_RW(local_hbm);
+
+static struct attribute *xiaomi_l12_attrs[] = {
+	&dev_attr_local_hbm.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(xiaomi_l12);
+
 static const struct backlight_ops xiaomi_l12_bl_ops = {
 	.update_status = xiaomi_l12_bl_update_status,
 };
@@ -965,6 +1070,7 @@
 	.driver = {
 		.name = "panel-xiaomi-l12-36-02-0b",
 		.of_match_table = xiaomi_l12_of_match,
+		.dev_groups = xiaomi_l12_groups,
 	},
 };
 module_mipi_dsi_driver(xiaomi_l12_driver);
-- 
2.43.0
