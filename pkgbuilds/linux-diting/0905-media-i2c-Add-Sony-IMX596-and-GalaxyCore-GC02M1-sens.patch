+
+/* Copy one table of the camregs firmware into driver memory */
+static int imx596_parse_table(struct imx596 *imx596, const u8 *data,
+			      size_t size, size_t *pos, bool v2, char *name,
+			      struct imx596_table *out)
+{
+	struct imx596_reg *regs;
+	unsigned int i, n;
+	const u8 *e;
+	u8 *burst;
+
+	if (*pos + 20 > size)
+		return -EINVAL;
+	memcpy(name, data + *pos, 16);
+	name[15] = '\0';
+	n = get_unaligned_le32(data + *pos + 16);
+	*pos += 20;
+	if (n > 8192)
+		return -EINVAL;
+
+	regs = devm_kcalloc(imx596->dev, n, sizeof(*regs), GFP_KERNEL);
+	if (!regs)
+		return -ENOMEM;
+
+	for (i = 0; i < n; i++) {
+		if (*pos + 8 > size)
+			return -EINVAL;
+		e = data + *pos;
+		regs[i].addr = get_unaligned_le16(e);
+		regs[i].value = get_unaligned_le16(e + 2);
+		regs[i].width = e[4];
+		regs[i].delay_us = get_unaligned_le16(e + 6);
+		*pos += 8;
+
+		if (regs[i].width == 0 && v2) {
+			size_t len = regs[i].value;
+
+			if (!len || *pos + ALIGN(len, 4) > size)
+				return -EINVAL;
+			burst = devm_kmemdup(imx596->dev, data + *pos, len,
+					     GFP_KERNEL);
+			if (!burst)
+				return -ENOMEM;
+			regs[i].burst = burst;
+			*pos += ALIGN(len, 4);
+			continue;
+		}
+		if (regs[i].width != 1 && regs[i].width != 2)
+			return -EINVAL;
+		if (regs[i].width == 1 && regs[i].value > 0xff)
+			return -EINVAL;
+	}
+
+	out->regs = regs;
+	out->num_regs = n;
+
+	return 0;
+}
+
+static int imx596_load_tables(struct imx596 *imx596)
+{
+	const char *fw_name = IMX596_FW_DEFAULT;
+	const struct firmware *fw;
+	struct imx596_table table;
+	unsigned int i, j, n;
+	char name[16];
+	size_t pos;
+	bool v2;
+	int ret;
+
+	device_property_read_string(imx596->dev, "firmware-name", &fw_name);
+
+	ret = request_firmware(&fw, fw_name, imx596->dev);
+	if (ret)
+		return dev_err_probe(imx596->dev, ret,
+				     "failed to load register tables %s\n",
+				     fw_name);
+
+	ret = -EINVAL;
+	if (fw->size < 12)
+		goto out;
+	if (!memcmp(fw->data, "CAMREGS1", 8))
+		v2 = false;
+	else if (!memcmp(fw->data, "CAMREGS2", 8))
+		v2 = true;
+	else
+		goto out;
+
+	n = get_unaligned_le32(fw->data + 8);
+	pos = 12;
+	for (i = 0; i < n; i++) {
+		ret = imx596_parse_table(imx596, fw->data, fw->size, &pos, v2,
+					 name, &table);
+		if (ret)
+			goto out;
+
+		if (!strcmp(name, "init"))
+			imx596->init_table = table;
+		for (j = 0; j < ARRAY_SIZE(imx596_supported_modes); j++)
+			if (!strcmp(name, imx596_supported_modes[j].table))
+				imx596->mode_tables[j] = table;
+	}
+
+	ret = 0;
+	if (!imx596->init_table.num_regs)
+		ret = -EINVAL;
+	for (j = 0; j < ARRAY_SIZE(imx596_supported_modes); j++)
+		if (!imx596->mode_tables[j].num_regs)
+			ret = -EINVAL;
+
+out:
+	release_firmware(fw);
+	if (ret)
+		dev_err(imx596->dev, "invalid register tables in %s\n", fw_name);
+
+	return ret;
+}
+
+static int imx596_identify_sensor(struct imx596 *imx596)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(imx596->regmap, IMX596_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(imx596->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != IMX596_CHIP_ID) {
+		dev_err(imx596->dev, "chip id mismatch: %x!=%llx\n",
+			IMX596_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int imx596_check_hwcfg(struct imx596 *imx596)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx596->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX596_DATA_LANES) {
+		dev_err(imx596->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(imx596->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       imx596_link_freq_menu,
+				       ARRAY_SIZE(imx596_link_freq_menu),
+				       &freq_bitmap);
+	if (ret)
+		goto endpoint_free;
+
+	/* All modes are needed: both frequencies must be allowed */
+	if (freq_bitmap != GENMASK(ARRAY_SIZE(imx596_link_freq_menu) - 1, 0)) {
+		dev_err(imx596->dev, "link-frequencies must list %lld and %lld\n",
+			imx596_link_freq_menu[0], imx596_link_freq_menu[1]);
+		ret = -EINVAL;
+	}
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * Power-up order of the module data: I/O (WL2866D AVDD1), core (WL2866D
+ * DVDD1), analog, reset release, MCLK 19.2 MHz.
+ */
+static int imx596_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx596 *imx596 = to_imx596(sd);
+	int ret;
+
+	if (imx596->vddio) {
+		ret = regulator_enable(imx596->vddio);
+		if (ret)
+			return ret;
+	}
+
+	if (imx596->vddd) {
+		ret = regulator_enable(imx596->vddd);
+		if (ret)
+			goto disable_vddio;
+	}
+
+	if (imx596->vdda) {
+		ret = regulator_enable(imx596->vdda);
+		if (ret)
+			goto disable_vddd;
+	}
+
+	usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(imx596->mclk);
+	if (ret)
+		goto disable_vdda;
+
+	gpiod_set_value_cansleep(imx596->reset_gpio, 0);
+	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_vdda:
+	if (imx596->vdda)
+		regulator_disable(imx596->vdda);
+
+disable_vddd:
+	if (imx596->vddd)
+		regulator_disable(imx596->vddd);
+
+disable_vddio:
+	if (imx596->vddio)
+		regulator_disable(imx596->vddio);
+
+	return ret;
+}
+
+static int imx596_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx596 *imx596 = to_imx596(sd);
+
+	gpiod_set_value_cansleep(imx596->reset_gpio, 1);
+
+	clk_disable_unprepare(imx596->mclk);
+
+	if (imx596->vdda)
+		regulator_disable(imx596->vdda);
+
+	if (imx596->vddd)
+		regulator_disable(imx596->vddd);
+
+	if (imx596->vddio)
+		regulator_disable(imx596->vddio);
+
+	return 0;
+}
+
+static struct regulator *imx596_get_supply(struct imx596 *imx596,
+					   const char *name)
+{
+	struct regulator *reg;
+
+	reg = devm_regulator_get_optional(imx596->dev, name);
+	if (IS_ERR(reg) && PTR_ERR(reg) == -ENODEV)
+		return NULL;
+
+	return reg;
+}
+
+static int imx596_probe(struct i2c_client *client)
+{
+	struct imx596 *imx596;
+	unsigned long freq;
+	int ret;
+
+	imx596 = devm_kzalloc(&client->dev, sizeof(*imx596), GFP_KERNEL);
+	if (!imx596)
+		return -ENOMEM;
+
+	imx596->dev = &client->dev;
+	v4l2_i2c_subdev_init(&imx596->sd, client, &imx596_subdev_ops);
+
+	imx596->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx596->regmap))
+		return dev_err_probe(imx596->dev, PTR_ERR(imx596->regmap),
+				     "failed to init CCI\n");
+
+	imx596->mclk = devm_v4l2_sensor_clk_get(imx596->dev, NULL);
+	if (IS_ERR(imx596->mclk))
+		return dev_err_probe(imx596->dev, PTR_ERR(imx596->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(imx596->mclk);
+	if (freq != IMX596_MCLK_FREQ)
+		return dev_err_probe(imx596->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = imx596_check_hwcfg(imx596);
+	if (ret)
+		return dev_err_probe(imx596->dev, ret,
+				     "failed to check HW configuration\n");
+
+	imx596->reset_gpio = devm_gpiod_get_optional(imx596->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx596->reset_gpio))
+		return dev_err_probe(imx596->dev, PTR_ERR(imx596->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	imx596->vdda = imx596_get_supply(imx596, "vdda");
+	if (IS_ERR(imx596->vdda))
+		return dev_err_probe(imx596->dev, PTR_ERR(imx596->vdda),
+				     "Failed to get 'vdda' regulator\n");
+
+	imx596->vddd = imx596_get_supply(imx596, "vddd");
+	if (IS_ERR(imx596->vddd))
+		return dev_err_probe(imx596->dev, PTR_ERR(imx596->vddd),
+				     "Failed to get 'vddd' regulator\n");
+
+	imx596->vddio = imx596_get_supply(imx596, "vddio");
+	if (IS_ERR(imx596->vddio))
+		return dev_err_probe(imx596->dev, PTR_ERR(imx596->vddio),
+				     "Failed to get 'vddio' regulator\n");
+
+	ret = imx596_load_tables(imx596);
+	if (ret)
+		return ret;
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = imx596_power_on(imx596->dev);
+	if (ret)
+		return ret;
+
+	ret = imx596_identify_sensor(imx596);
+	if (ret) {
+		dev_err_probe(imx596->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	imx596->mode = &imx596_supported_modes[IMX596_DEFAULT_MODE];
+	ret = imx596_init_controls(imx596);
+	if (ret) {
+		dev_err_probe(imx596->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	imx596->sd.state_lock = imx596->ctrl_handler.lock;
+	imx596->sd.internal_ops = &imx596_internal_ops;
+	imx596->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx596->sd.entity.ops = &imx596_subdev_entity_ops;
+	imx596->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx596->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx596->sd.entity, 1, &imx596->pad);
+	if (ret) {
+		dev_err_probe(imx596->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&imx596->sd);
+	if (ret < 0) {
+		dev_err_probe(imx596->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(imx596->dev);
+	pm_runtime_enable(imx596->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx596->sd);
+	if (ret < 0) {
+		dev_err_probe(imx596->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(imx596->dev, 1000);
+	pm_runtime_use_autosuspend(imx596->dev);
+	pm_runtime_idle(imx596->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&imx596->sd);
+	pm_runtime_disable(imx596->dev);
+	pm_runtime_set_suspended(imx596->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&imx596->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(imx596->sd.ctrl_handler);
+
+power_off:
+	imx596_power_off(imx596->dev);
+
+	return ret;
+}
+
+static void imx596_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx596 *imx596 = to_imx596(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(imx596->dev);
+
+	if (!pm_runtime_status_suspended(imx596->dev)) {
+		imx596_power_off(imx596->dev);
+		pm_runtime_set_suspended(imx596->dev);
+	}
+}
+
+static const struct dev_pm_ops imx596_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx596_power_off, imx596_power_on, NULL)
+};
+
+static const struct of_device_id imx596_of_match[] = {
+	{ .compatible = "sony,imx596" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx596_of_match);
+
+static struct i2c_driver imx596_i2c_driver = {
+	.driver = {
+		.name = "imx596",
+		.pm = &imx596_pm_ops,
+		.of_match_table = imx596_of_match,
+	},
+	.probe = imx596_probe,
+	.remove = imx596_remove,
+};
+
+module_i2c_driver(imx596_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX596 image sensor driver");
+MODULE_LICENSE("GPL");
