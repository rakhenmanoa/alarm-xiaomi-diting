_make() {
  local cross=()
  if [ "$(uname -m)" != aarch64 ]; then
    cross=(CROSS_COMPILE="${DITING_CROSS_COMPILE:-aarch64-linux-gnu-}")
  fi
  make ARCH=arm64 "${cross[@]}" \
    KBUILD_BUILD_USER=alarm KBUILD_BUILD_HOST=alarm-diting \
    LOCALVERSION= "$@"
}

prepare() {
  cd "linux-${_kver}"
  local p
  for p in "$srcdir"/diting-ubuntu/kernel/patches/*.patch; do
    echo "patch : ${p##*/}"
    patch -Np1 --no-backup-if-mismatch -s < "$p"
  done
  # variante d'écran tactile Goodix GT9916 (au lieu du ST FTM5)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0900-arm64-dts-diting-Goodix-GT9916-touchscreen.patch"
  # écran « 42 02 0a » (choisi d'après le panneau signalé par le bootloader)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0901-drm-panel-xiaomi-l12-Add-the-42-02-0a-panel.patch"
  # option msm.dsc_slice_per_pkt (la 42 02 0a veut les 2 tranches DSC par paquet)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0902-drm-msm-dsi-DSC-slice-per-packet-option.patch"
  # micros : ports SoundWire TX séparés (sinon ADC1 et ADC4 se brouillent)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0903-arm64-dts-diting-separate-TX-SoundWire-mic-ports.patch"
  # vibreur : pilote minimal du bloc haptique du PM8350B (+ nœud DT)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0904-Input-pm8350b-haptics-and-diting-vibrator.patch"
  # caméras frontale (IMX596) et macro (GC02M1) : pilotes + device tree
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0905-media-i2c-Add-Sony-IMX596-and-GalaxyCore-GC02M1-sens.patch"
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0906-arm64-dts-qcom-sm8475-xiaomi-diting-Add-the-front-an.patch"
  # caméra principale : gain analogique 64x dans les modes regroupés
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0907-media-i2c-s5khp1-Allow-64x-analogue-gain-in-the-binn.patch"
  # mode 50 MP du S5KHP1 (8192 de large, limite CAMSS 8191), sans le mode 200 MP
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0908-media-qcom-camss-Allow-16384-pixel-raw-frames-s5khp1.patch"
  # SLPI : IRQ handover coupée une fois le handover fait (backport Linux 7.3) ;
  # sinon chaque échantillon d'un capteur ouvert la redéclenche (~10/s)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0910-remoteproc-qcom_q6v5-Disable-the-handover-IRQ-once-h.patch"
  # HP1 : exposition gardée d'un mode à l'autre (aperçu -> photo 50 MP)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0911-media-i2c-s5khp1-Keep-the-exposure-across-mode-chang.patch"
  # flash arrière : LED unique sur le canal 0 du PM8350C (lampe torche Plasma)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0912-arm64-dts-qcom-sm8475-xiaomi-diting-Enable-the-rear-.patch"
  # émetteur infrarouge : LED sur la ligne MOSI de SPI13 (ir-spi, /dev/lirc0)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0913-arm64-dts-qcom-sm8475-xiaomi-diting-Add-the-IR-blast.patch"
  # thermistances de la carte (ADC7 / ADC-TM du PMK8350) et zones thermiques
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0914-arm64-dts-qcom-sm8475-xiaomi-diting-Add-the-board-th.patch"
  # connecteur USB-C sous pmic-glink : rôle hôte (OTG) par UCSI
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0915-arm64-dts-qcom-sm8475-xiaomi-diting-Describe-the-USB.patch"
  # luminosité : courbe réglable (plancher bl_min_dbv, courbure bl_courbe)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0916-drm-panel-xiaomi-l12-Tunable-backlight-curve.patch"
  # HBM optionnel (bl_hbm=1 : haut du curseur jusqu'à DBV 4095)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0917-drm-panel-xiaomi-l12-Optional-high-brightness-mode.patch"
  # QSEECOM : applis TrustZone « à l'ancienne » (appli d'empreintes Goodix),
  # rétroportage de samcday/linux wip/sargo-fingerprint
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0918-tee-Add-the-Qualcomm-QSEECOM-TEE-driver-backport.patch"
  # qcomtee : zones partagées de plus de 4 Mo prises dans la réserve CMA
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0919-tee-qcomtee-Allocate-large-shared-buffers-from-CMA.patch"
  # qseecom : rendre la requête (statut de gfdit à l'octet 28)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0920-tee-qseecom-Give-the-request-back-on-INOUT.patch"
  # empreintes : L1C, L7C et L11C (alimentations du capteur Goodix) toujours allumées
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0922-arm64-dts-qcom-sm8475-xiaomi-diting-Keep-L1C-L7C-and-L11C-on-for-the-fingerprint-sensor.patch"
  # dalle 42 02 0a : HBM local sous le capteur d'empreintes (fichier local_hbm)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0923-drm-panel-xiaomi-l12-Local-high-brightness-mode.patch"
  # dalle : verrou sur les accès DSI (luminosité pendant l'init), contrôle du power mode
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0924-drm-panel-xiaomi-l12-Serialise-DSI-access.patch"
  # dalle : ligne ESD (TLMM 116) avec relance, dimming, luminosité après la 1re image
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0925-drm-panel-xiaomi-l12-ESD-recovery-dimming-first-frame.patch"
  # GPU : chemin interconnect gfx-mem et opp-peak-kBps (le GPU vote la bande passante DDR)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0926-arm64-dts-qcom-sm8475-GPU-DDR-bandwidth-votes.patch"
  # moniteurs de bande passante CPU→LLCC et LLCC→DDR (la DDR monte avec le trafic)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0927-arm64-dts-qcom-sm8475-Add-the-CPU-and-LLCC-bwmon.patch"
  # capacité et modèle d'énergie des cœurs (ordonnanceur énergétique EAS)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0928-arm64-dts-qcom-sm8475-CPU-capacity-and-energy-model.patch"
  # votes DDR/LLCC/L3 des CPU et fournisseur EPSS L3 (voir cpu/README.md)
  patch -Np1 --no-backup-if-mismatch < "$srcdir/0929-arm64-dts-qcom-sm8475-CPU-DDR-LLCC-L3-bandwidth-votes.patch"

  _make defconfig
  scripts/kconfig/merge_config.sh -m .config "$srcdir/diting-ubuntu/kernel/config/diting.config"
  # Landlock (bac à sable de pacman 7) : déjà dans CONFIG_LSM de diting-ubuntu,
  # mais l'option elle-même n'y est pas activée
  scripts/config --enable SECURITY_LANDLOCK
  # pilote du tactile Goodix GT9916 (variante Goodix du diting)
  scripts/config --module TOUCHSCREEN_GOODIX_BERLIN_SPI
  # vibreur (patch 0904)
  scripts/config --module INPUT_QCOM_PM8350B_HAPTICS
  # caméras frontale et macro (patch 0905)
  scripts/config --module VIDEO_IMX596 --module VIDEO_GC02M1
  # flash arrière (patch 0912)
  scripts/config --module LEDS_QCOM_FLASH
  # infrarouge (patch 0913) : interface LIRC dans rc-core, pilote ir-spi
  scripts/config --enable LIRC --module IR_SPI
  # applis TrustZone par QSEECOM (patch 0918)
  scripts/config --module TEE_QSEECOM
  # zram (swap compressé en mémoire, zram-generator dans diting-device)
  scripts/config --module ZRAM --enable ZRAM_BACKEND_LZ4 --enable ZRAM_BACKEND_ZSTD \
    --enable ZRAM_DEF_COMP_ZSTD
  # fournisseur L3 intégré (pas module) : cpufreq-hw en a besoin au probe (patch 0929)
  scripts/config --enable INTERCONNECT_QCOM_OSM_L3
  _make olddefconfig

  # chaque option du fragment doit survivre à olddefconfig (comme diting-ubuntu)
  local line missing=0
  while IFS= read -r line; do
    case "$line" in
      CONFIG_*=*|"# CONFIG_"*" is not set")
        grep -qxF "$line" .config || { echo "option perdue : $line"; missing=1; } ;;
    esac
  done < "$srcdir/diting-ubuntu/kernel/config/diting.config"
  [ "$missing" = 0 ]

  _make -s kernelrelease > version
  echo "version du noyau : $(<version)"
}

build() {
  cd "linux-${_kver}"
  _make -j"$(nproc)" Image modules dtbs
}

package() {
  cd "linux-${_kver}"
  local kernver modulesdir
  kernver="$(<version)"
  modulesdir="$pkgdir/usr/lib/modules/$kernver"

  # Image arm64 non compressée (comme le noyau stock, voir BOOT_LAYOUT.md).
  # Le hook pacman de mkinitcpio la copie dans /boot/vmlinuz-linux-diting.
  install -Dm644 arch/arm64/boot/Image "$modulesdir/vmlinuz"
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  _make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=/doesnt/exist modules_install
  rm -f "$modulesdir"/{build,source}

  install -Dm644 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dtb \
    "$pkgdir/boot/dtbs/qcom/sm8475-xiaomi-diting.dtb"
  install -Dm644 .config "$pkgdir/usr/share/doc/$pkgname/config"
  install -Dm644 System.map "$modulesdir/System.map"

  # une seule image (pas de « fallback » : vendor_boot ne fait que 96 Mio)
  install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/${pkgbase}.preset" <<EOF
# mkinitcpio preset pour ${pkgbase} (diting)
ALL_kver="/boot/vmlinuz-${pkgbase}"
PRESETS=('default')
default_image="/boot/initramfs-${pkgbase}.img"
EOF
}
