From: Fanasina <noreply@example.invalid>
Subject: [PATCH] media: qcom: camss: Add the ICP driver and its HFI layer

Boots the Image Control Processor of the Titan camera subsystem (SM8475)
and talks to its firmware through the HFI queues: SYS_INIT, ping and
IPE/BPS handle creation. Based on the Linaro RFC "ICP boots, stats"
(2026-07-03), whose camss-icp-hfi.c was missing, rewritten here from the
GPL downstream camera-kernel hfi.c. IPE and BPS are not built yet.

diff --git a/drivers/media/platform/qcom/camss/Kconfig b/drivers/media/platform/qcom/camss/Kconfig
index 4eda48c..195855a 100644
--- a/drivers/media/platform/qcom/camss/Kconfig
+++ b/drivers/media/platform/qcom/camss/Kconfig
@@ -7,3 +7,16 @@ config VIDEO_QCOM_CAMSS
 	select VIDEO_V4L2_SUBDEV_API
 	select VIDEOBUF2_DMA_SG
 	select V4L2_FWNODE
+
+config VIDEO_QCOM_CAMSS_HARD_ISP
+	tristate "Qualcomm CAMSS hardware ISP (ICP firmware interface)"
+	depends on VIDEO_QCOM_CAMSS
+	depends on QCOM_MDT_LOADER
+	depends on QCOM_SCM
+	depends on VIDEO_DEV
+	help
+	  Boots the Image Control Processor (ICP) of the Titan camera
+	  subsystem and talks to its firmware through the HFI queues. This
+	  is the base for the BPS and IPE image processing engines.
+
+	  The firmware (CAMERA_ICP) is not part of the kernel tree.
diff --git a/drivers/media/platform/qcom/camss/Makefile b/drivers/media/platform/qcom/camss/Makefile
index 27898b3..056ea29 100644
--- a/drivers/media/platform/qcom/camss/Makefile
+++ b/drivers/media/platform/qcom/camss/Makefile
@@ -31,3 +31,6 @@ qcom-camss-objs += \
 		camss-video.o
 
 obj-$(CONFIG_VIDEO_QCOM_CAMSS) += qcom-camss.o
+
+qcom-camss-icp-objs += camss-icp.o camss-icp-hfi.o
+obj-$(CONFIG_VIDEO_QCOM_CAMSS_HARD_ISP) += qcom-camss-icp.o
diff --git a/drivers/media/platform/qcom/camss/camss-icp-hfi.c b/drivers/media/platform/qcom/camss/camss-icp-hfi.c
new file mode 100644
index 0000000..ce0e70e
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-icp-hfi.c
@@ -0,0 +1,572 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Qualcomm CAMSS ICP - HFI (Host Firmware Interface) queue handling
+ *
+ * Protocol layout follows the downstream camera-kernel hfi.c (GPL-2.0).
+ */
+
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/minmax.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "camss-icp.h"
+#include "camss-icp-hfi.h"
+
+#define HFI_MAX_PKT_WORDS	25600
+#define HFI_MSGQ_MAX_WORDS	2048
+
+#define HFI_QHDR_ACTIVE		1
+#define HFI_Q_TABLE_QUEUES	4	/* table holds 4 headers, 3 are active */
+#define HFI_Q_DBG_TX_WM		1024
+#define HFI_CMD_TIMEOUT_MS	2000
+
+/* Queue data sizes in bytes, same as the downstream driver */
+static const u32 hfi_q_bytes[HFI_Q_MAX] = {
+	[HFI_Q_CMD_TYPE] = 8192,
+	[HFI_Q_MSG_TYPE] = 8192,
+	[HFI_Q_DBG_TYPE] = 102400,
+};
+
+static struct hfi_q_hdr *hfi_q(struct icp_hfi *hfi, int id)
+{
+	return &hfi->q_tbl->q_hdr[id];
+}
+
+static int hfi_alloc(struct device *dev, struct icp_hfi_mem_region *r, size_t size)
+{
+	r->vaddr = dma_alloc_coherent(dev, size, &r->dma_addr, GFP_KERNEL);
+	if (!r->vaddr)
+		return -ENOMEM;
+	r->size = size;
+	return 0;
+}
+
+static void hfi_free(struct device *dev, struct icp_hfi_mem_region *r)
+{
+	if (r->vaddr)
+		dma_free_coherent(dev, r->size, r->vaddr, r->dma_addr);
+	memset(r, 0, sizeof(*r));
+}
+
+static void hfi_carve(struct icp_hfi_mem_region *dst,
+		      const struct icp_hfi_mem_region *base,
+		      size_t off, size_t size)
+{
+	dst->vaddr = base->vaddr + off;
+	dst->dma_addr = base->dma_addr + off;
+	dst->size = size;
+}
+
+static void hfi_q_setup(struct icp_hfi *hfi, int id)
+{
+	struct hfi_q_hdr *q = hfi_q(hfi, id);
+
+	memset(q, 0, sizeof(*q));
+	q->status = HFI_QHDR_ACTIVE;
+	q->start_addr = lower_32_bits(hfi->hfi_mem.q_data[id].dma_addr);
+	q->q_size = hfi_q_bytes[id] >> HFI_BYTE_WORD_SHIFT;
+	q->pkt_size = 0;		/* variable size packets */
+	q->type = id;
+
+	/* Interrupt driven mode, as in the downstream INTR_MODE */
+	q->rx_wm = 1;
+	q->tx_wm = 1;
+	if (id == HFI_Q_DBG_TYPE) {
+		q->tx_wm = HFI_Q_DBG_TX_WM;
+		q->rx_req = 0;
+	} else {
+		q->rx_req = 1;
+	}
+}
+
+int icp_hfi_init_queues(struct icp_hfi *hfi)
+{
+	const struct hfi_resources *res = hfi->res;
+	struct icp_hfi_mem *mem = &hfi->hfi_mem;
+	struct hfi_q_tbl_hdr *tbl;
+	size_t off = 0;
+	int i, ret;
+
+	/*
+	 * The firmware registers are 32 bit wide. The downstream camera driver
+	 * puts the shared, fw_uncached and QDSS regions below 0x10c00000,
+	 * under the "io" region the firmware uses for client buffers. Keep the
+	 * IOVAs under 256 MiB for the same reason: the default top-down
+	 * allocation would place them at the very top of the 32 bit space.
+	 */
+	ret = dma_set_mask_and_coherent(hfi->dev, DMA_BIT_MASK(28));
+	if (ret)
+		return ret;
+
+	mutex_init(&hfi->cmd_lock);
+	init_completion(&hfi->cmd_complete);
+
+	hfi->rx_buf = kmalloc_array(HFI_MAX_PKT_WORDS, sizeof(u32), GFP_KERNEL);
+	if (!hfi->rx_buf)
+		return -ENOMEM;
+
+	ret = hfi_alloc(hfi->dev, &mem->shmem, res->shmem_size);
+	if (ret)
+		goto err;
+	ret = hfi_alloc(hfi->dev, &mem->qdss, res->qdss_size);
+	if (ret)
+		goto err;
+	ret = hfi_alloc(hfi->dev, &mem->fwuncached, res->fwuncached_size);
+	if (ret)
+		goto err;
+
+	/* Sub-regions of the firmware uncached heap */
+	hfi_carve(&mem->secheap, &mem->fwuncached, off, res->secheap_size);
+	off += res->secheap_size;
+	hfi_carve(&mem->q_tbl, &mem->fwuncached, off, res->q_tbl_size);
+	off += res->q_tbl_size;
+	for (i = 0; i < HFI_Q_MAX; i++) {
+		hfi_carve(&mem->q_data[i], &mem->fwuncached, off,
+			  res->qdata_size[i]);
+		off += res->qdata_size[i];
+	}
+	hfi_carve(&mem->sfr, &mem->fwuncached, off, res->sfr_size);
+	off += res->sfr_size;
+
+	if (off > mem->fwuncached.size) {
+		dev_err(hfi->dev, "HFI sub-regions (%zu) exceed fw uncached (%zu)\n",
+			off, mem->fwuncached.size);
+		ret = -ENOSPC;
+		goto err;
+	}
+
+	memset(mem->fwuncached.vaddr, 0, mem->fwuncached.size);
+
+	/* Queue table */
+	tbl = mem->q_tbl.vaddr;
+	hfi->q_tbl = tbl;
+	tbl->version = HFI_QTBL_VERSION;
+	tbl->size = sizeof(*tbl) + HFI_Q_TABLE_QUEUES * sizeof(struct hfi_q_hdr);
+	tbl->q_hdr0_offset = sizeof(*tbl);
+	tbl->q_hdr_size = sizeof(struct hfi_q_hdr);
+	tbl->num_queues = HFI_Q_MAX;
+	tbl->num_active_queues = HFI_Q_MAX;
+
+	for (i = 0; i < HFI_Q_MAX; i++)
+		hfi_q_setup(hfi, i);
+
+	hfi->sfr = mem->sfr.vaddr;
+	hfi->sfr->size = HFI_SFR_LOG_SIZE;
+
+	hfi->ready = false;
+
+	/* Make the tables visible to the firmware before it is started */
+	wmb();
+	return 0;
+err:
+	icp_hfi_deinit_queues(hfi);
+	return ret;
+}
+
+void icp_hfi_deinit_queues(struct icp_hfi *hfi)
+{
+	struct icp_hfi_mem *mem = &hfi->hfi_mem;
+
+	hfi->ready = false;
+	hfi->q_tbl = NULL;
+	hfi->sfr = NULL;
+
+	kfree(hfi->rx_buf);
+	hfi->rx_buf = NULL;
+
+	memset(&mem->secheap, 0, sizeof(mem->secheap));
+	memset(&mem->q_tbl, 0, sizeof(mem->q_tbl));
+	memset(mem->q_data, 0, sizeof(mem->q_data));
+	memset(&mem->sfr, 0, sizeof(mem->sfr));
+
+	hfi_free(hfi->dev, &mem->fwuncached);
+	hfi_free(hfi->dev, &mem->qdss);
+	hfi_free(hfi->dev, &mem->shmem);
+}
+
+/* Copy one packet into the command queue and kick the firmware */
+static int hfi_write_cmd(struct icp_hfi *hfi, void *pkt)
+{
+	struct hfi_q_hdr *q = hfi_q(hfi, HFI_Q_CMD_TYPE);
+	u32 *data = hfi->hfi_mem.q_data[HFI_Q_CMD_TYPE].vaddr;
+	u32 words = hfi_pkt_size(pkt) >> HFI_BYTE_WORD_SHIFT;
+	u32 ri, wi, size, space, first;
+
+	if (!hfi->q_tbl)
+		return -ENODEV;
+	if (!words)
+		return -EINVAL;
+
+	size = q->q_size;
+	ri = READ_ONCE(q->read_idx);
+	wi = READ_ONCE(q->write_idx);
+	if (ri >= size || wi >= size)
+		return -EIO;
+
+	space = (wi >= ri) ? size - (wi - ri) : ri - wi;
+	if (space <= words)
+		return -ENOSPC;
+
+	first = min(words, size - wi);
+	memcpy(data + wi, pkt, first * 4);
+	if (words > first)
+		memcpy(data, (u32 *)pkt + first, (words - first) * 4);
+
+	/* Data must be visible before the index moves */
+	wmb();
+	WRITE_ONCE(q->write_idx, (wi + words) % size);
+	wmb();
+
+	hfi->ops->raise_irq(hfi->priv);
+	return 0;
+}
+
+/* Read one packet from a firmware-to-host queue. Returns words, 0 if empty */
+static int hfi_read_pkt(struct icp_hfi *hfi, int id, u32 *buf, u32 max_words)
+{
+	struct hfi_q_hdr *q = hfi_q(hfi, id);
+	u32 *data = hfi->hfi_mem.q_data[id].vaddr;
+	u32 size = q->q_size;
+	u32 ri = READ_ONCE(q->read_idx);
+	u32 wi = READ_ONCE(q->write_idx);
+	u32 avail, words, first;
+
+	if (ri == wi)
+		return 0;
+
+	if (ri >= size || wi >= size) {
+		dev_err(hfi->dev, "HFI q%d: bad indexes r=%u w=%u size=%u\n",
+			id, ri, wi, size);
+		WRITE_ONCE(q->read_idx, wi < size ? wi : 0);
+		return -EIO;
+	}
+
+	dma_rmb();
+	avail = (wi > ri) ? wi - ri : size - ri + wi;
+	words = data[ri] >> HFI_BYTE_WORD_SHIFT;
+	if (!words || words > avail || words > max_words) {
+		dev_err(hfi->dev, "HFI q%d: bad packet size %u words (avail %u)\n",
+			id, words, avail);
+		WRITE_ONCE(q->read_idx, wi);
+		return -EIO;
+	}
+
+	first = min(words, size - ri);
+	memcpy(buf, data + ri, first * 4);
+	if (words > first)
+		memcpy(buf + first, data, (words - first) * 4);
+
+	wmb();
+	WRITE_ONCE(q->read_idx, (ri + words) % size);
+	return words;
+}
+
+static void hfi_handle_msg(struct icp_hfi *hfi, u32 *pkt)
+{
+	u32 type = hfi_pkt_type(pkt);
+
+	switch (type) {
+	case HFI_MSG_SYS_INIT_DONE: {
+		struct hfi_msg_init_done *m = (void *)pkt;
+
+		hfi->ack_error = m->error;
+		hfi->prop_num = min_t(u32, m->prop_num, HFI_MAX_PROPS);
+		memcpy(hfi->properties, m->prop_data, hfi->prop_num * 4);
+		dev_dbg(hfi->dev, "HFI SYS_INIT_DONE error=%u props=%u\n",
+			m->error, m->prop_num);
+		complete(&hfi->cmd_complete);
+		break;
+	}
+	case HFI_MSG_SYS_PING_ACK:
+		hfi->ack_error = 0;
+		complete(&hfi->cmd_complete);
+		break;
+	case HFI_MSG_IPEBPS_CREATE_HANDLE_ACK: {
+		struct hfi_msg_create_handle_ack *m = (void *)pkt;
+
+		hfi->ack_error = m->error;
+		hfi->ack_handle = m->fw_handle;
+		complete(&hfi->cmd_complete);
+		break;
+	}
+	case HFI_MSG_IPEBPS_ASYNC_DIRECT_ACK:
+	case HFI_MSG_IPEBPS_ASYNC_INDIRECT_ACK: {
+		struct hfi_msg_async_ack *m = (void *)pkt;
+
+		dev_dbg(hfi->dev, "HFI async ack opcode=%u error=%u status=%u\n",
+			m->opcode, m->error, m->msg[0]);
+		/* msg[0] is the status of the abort/destroy/config reply */
+		hfi->ack_error = m->error ? m->error : m->msg[0];
+		hfi->ack_msg[0] = m->msg[0];
+		hfi->ack_msg[1] = m->msg[1];
+		hfi->ack_msg[2] = m->msg[2];
+		complete(&hfi->cmd_complete);
+		break;
+	}
+	case HFI_MSG_EVENT_NOTIFY: {
+		struct hfi_msg_event *m = (void *)pkt;
+
+		dev_err(hfi->dev, "HFI event: session=%u id=%u data=%u,%u\n",
+			m->session_id, m->event_id, m->data1, m->data2);
+		break;
+	}
+	case HFI_MSG_SYS_IDLE:
+	case HFI_MSG_SYS_PC_PREP_DONE:
+	case HFI_MSG_SYS_PROPERTY_INFO:
+	case HFI_MSG_SYS_RESET_ACK:
+		dev_dbg(hfi->dev, "HFI message 0x%x\n", type);
+		break;
+	default:
+		dev_warn(hfi->dev, "HFI: unhandled message 0x%x\n", type);
+		break;
+	}
+}
+
+bool icp_hfi_process_msg_queue(struct icp_hfi *hfi)
+{
+	bool any = false;
+	int words;
+
+	if (!hfi->q_tbl || !hfi->rx_buf)
+		return false;
+
+	while ((words = hfi_read_pkt(hfi, HFI_Q_MSG_TYPE, hfi->rx_buf,
+				     HFI_MSGQ_MAX_WORDS)) != 0) {
+		if (words < 0)
+			continue;
+		hfi_handle_msg(hfi, hfi->rx_buf);
+		any = true;
+	}
+
+	return any;
+}
+
+void icp_hfi_flush_debug_queue(struct icp_hfi *hfi)
+{
+	int words, budget = 64;
+
+	if (!hfi->q_tbl || !hfi->rx_buf)
+		return;
+
+	while (budget-- &&
+	       (words = hfi_read_pkt(hfi, HFI_Q_DBG_TYPE, hfi->rx_buf,
+				     HFI_MAX_PKT_WORDS)) != 0) {
+		struct hfi_msg_debug *m = (void *)hfi->rx_buf;
+		u32 len;
+
+		if (words < 0 || words * 4 < sizeof(*m))
+			continue;
+		len = min_t(u32, m->msg_size, words * 4 - sizeof(*m));
+		dev_info(hfi->dev, "ICP: %.*s\n", (int)len, m->msg_data);
+	}
+}
+
+void icp_hfi_dump_sfr(struct icp_hfi *hfi)
+{
+	if (!hfi->sfr)
+		return;
+
+	/* Make sure the log is a C string */
+	hfi->sfr->msg[HFI_SFR_LOG_SIZE - 1] = '\0';
+	if (hfi->sfr->msg[0])
+		dev_err(hfi->dev, "ICP SFR: %s\n", hfi->sfr->msg);
+	else
+		dev_err(hfi->dev, "ICP SFR: empty\n");
+}
+
+/* Send a command and wait for its reply. Caller holds cmd_lock. */
+static int hfi_send_wait(struct icp_hfi *hfi, void *pkt, u32 timeout_ms)
+{
+	int ret;
+
+	reinit_completion(&hfi->cmd_complete);
+	hfi->ack_error = 0;
+
+	ret = hfi_write_cmd(hfi, pkt);
+	if (ret)
+		return ret;
+
+	if (!wait_for_completion_timeout(&hfi->cmd_complete,
+					 msecs_to_jiffies(timeout_ms))) {
+		dev_err(hfi->dev, "HFI command 0x%x timed out\n", hfi_pkt_type(pkt));
+		return -ETIMEDOUT;
+	}
+
+	if (hfi->ack_error) {
+		dev_err(hfi->dev, "HFI command 0x%x: firmware error 0x%x\n",
+			hfi_pkt_type(pkt), hfi->ack_error);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+int icp_hfi_core_init(struct icp_hfi *hfi)
+{
+	struct hfi_cmd_sys_init init = {
+		.hdr = { .size = sizeof(init), .type = HFI_CMD_SYS_INIT },
+	};
+	struct hfi_cmd_ping ping = {
+		.hdr = { .size = sizeof(ping), .type = HFI_CMD_SYS_PING },
+		.user_data = 0x1234,
+	};
+	int ret;
+
+	mutex_lock(&hfi->cmd_lock);
+
+	ret = hfi_send_wait(hfi, &init, HFI_CMD_TIMEOUT_MS);
+	if (ret) {
+		dev_err(hfi->dev, "HFI SYS_INIT failed: %d\n", ret);
+		icp_hfi_dump_sfr(hfi);
+		goto out;
+	}
+
+	ret = hfi_send_wait(hfi, &ping, HFI_CMD_TIMEOUT_MS);
+	if (ret) {
+		dev_err(hfi->dev, "HFI ping failed: %d\n", ret);
+		icp_hfi_dump_sfr(hfi);
+		goto out;
+	}
+
+	hfi->ready = true;
+	dev_info(hfi->dev, "HFI ready, fw version 0x%08x\n", hfi->fw_version);
+out:
+	mutex_unlock(&hfi->cmd_lock);
+	return ret;
+}
+
+int icp_hfi_create_handle(struct icp_hfi *hfi, u32 handle_type,
+			  u64 ctx, u32 *fw_handle, u32 timeout_ms)
+{
+	struct hfi_cmd_create_handle cmd = {
+		.hdr = { .size = sizeof(cmd), .type = HFI_CMD_IPEBPS_CREATE_HANDLE },
+		.handle_type = handle_type,
+		.user_data0 = ctx,
+	};
+	int ret;
+
+	if (!hfi->ready)
+		return -ENODEV;
+
+	mutex_lock(&hfi->cmd_lock);
+	ret = hfi_send_wait(hfi, &cmd, timeout_ms);
+	if (!ret)
+		*fw_handle = hfi->ack_handle;
+	mutex_unlock(&hfi->cmd_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(icp_hfi_create_handle);
+
+int icp_hfi_destroy_handle(struct icp_hfi *hfi, u32 handle_type,
+			   u64 ctx, u32 fw_handle, u32 timeout_ms)
+{
+	/* The direct payload is one u64 of user data (hfi_cmd_abort_destroy) */
+	struct {
+		struct hfi_cmd_async cmd;
+		u64 user_data;
+	} __packed pkt = {
+		.cmd = {
+			.hdr = {
+				.size = sizeof(pkt),
+				.type = HFI_CMD_IPEBPS_ASYNC_COMMAND_DIRECT,
+			},
+			.opcode = handle_type == HFI_DEV_TYPE_BPS ?
+				  HFI_IPEBPS_CMD_OPCODE_BPS_DESTROY :
+				  HFI_IPEBPS_CMD_OPCODE_IPE_DESTROY,
+			.user_data0 = ctx,
+			.num_handles = 1,
+			.handle = { fw_handle },
+		},
+		.user_data = ctx,
+	};
+	int ret;
+
+	if (!hfi->ready)
+		return -ENODEV;
+
+	mutex_lock(&hfi->cmd_lock);
+	ret = hfi_send_wait(hfi, &pkt, timeout_ms);
+	mutex_unlock(&hfi->cmd_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(icp_hfi_destroy_handle);
+
+/* Address of a chunk of the shared memory region, for indirect payloads */
+void *icp_hfi_shmem(struct icp_hfi *hfi, size_t offset, size_t size, u32 *iova)
+{
+	struct icp_hfi_mem_region *shmem = &hfi->hfi_mem.shmem;
+
+	if (!shmem->vaddr || offset + size > shmem->size)
+		return NULL;
+	if (iova)
+		*iova = lower_32_bits(shmem->dma_addr) + offset;
+	return shmem->vaddr + offset;
+}
+EXPORT_SYMBOL_GPL(icp_hfi_shmem);
+
+/*
+ * Send an IPE/BPS command whose payload is passed by address and wait for
+ * its reply. reply[] receives the first three words of the reply data.
+ */
+int icp_hfi_async_indirect(struct icp_hfi *hfi, u32 opcode, u64 ctx,
+			   u32 fw_handle, u32 iova, u32 *reply, u32 timeout_ms)
+{
+	struct {
+		struct hfi_cmd_async cmd;
+		u32 indirect;
+	} __packed pkt = {
+		.cmd = {
+			.hdr = {
+				.size = sizeof(pkt),
+				.type = HFI_CMD_IPEBPS_ASYNC_COMMAND_INDIRECT,
+			},
+			.opcode = opcode,
+			.user_data0 = ctx,
+			.num_handles = 1,
+			.handle = { fw_handle },
+		},
+		.indirect = iova,
+	};
+	int ret;
+
+	if (!hfi->ready)
+		return -ENODEV;
+
+	mutex_lock(&hfi->cmd_lock);
+	memset(hfi->ack_msg, 0, sizeof(hfi->ack_msg));
+	ret = hfi_send_wait(hfi, &pkt, timeout_ms);
+	if (reply)
+		memcpy(reply, hfi->ack_msg, sizeof(hfi->ack_msg));
+	mutex_unlock(&hfi->cmd_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(icp_hfi_async_indirect);
+
+/*
+ * Describe the input and output images of a session. The description is
+ * copied at the start of the shared memory region. reply[0] is the firmware
+ * return code, reply[1] and reply[2] the buffer sizes it asks for.
+ */
+int icp_hfi_config_io(struct icp_hfi *hfi, u32 handle_type, u64 ctx,
+		      u32 fw_handle, const void *cfg, size_t cfg_size,
+		      u32 *reply, u32 timeout_ms)
+{
+	u32 iova;
+	void *dst = icp_hfi_shmem(hfi, 0, cfg_size, &iova);
+
+	if (!dst)
+		return -EINVAL;
+	memcpy(dst, cfg, cfg_size);
+
+	return icp_hfi_async_indirect(hfi, handle_type == HFI_DEV_TYPE_BPS ?
+				      HFI_IPEBPS_CMD_OPCODE_BPS_CONFIG_IO :
+				      HFI_IPEBPS_CMD_OPCODE_IPE_CONFIG_IO,
+				      ctx, fw_handle, iova, reply, timeout_ms);
+}
+EXPORT_SYMBOL_GPL(icp_hfi_config_io);
