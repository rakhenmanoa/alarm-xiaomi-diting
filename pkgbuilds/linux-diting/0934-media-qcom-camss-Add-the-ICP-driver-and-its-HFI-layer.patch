+/*
+ * Stop the boot early to find where a hardware fault happens:
+ *   1 power, clocks and HW version read
+ *   2 + firmware loaded in the carveout (TrustZone init_image)
+ *   3 + HFI memory allocated, before TrustZone starts the ICP
+ *   4 + TrustZone started the ICP and returned (the ICP is then stopped)
+ *   5 + HFI registers programmed, before the init request
+ *   0 (default): full boot and HFI handshake
+ */
+static int icp_stage;
+module_param(icp_stage, int, 0444);
+MODULE_PARM_DESC(icp_stage, "Stop the ICP boot after step 1 to 5 (0 = full boot)");
+
