+	u32 prop_data[];
+} __packed;
+
+struct hfi_msg_debug {
+	struct hfi_pkt_hdr hdr;
+	u32 msg_type;
+	u32 msg_size;
+	u32 timestamp_hi;
+	u32 timestamp_lo;
+	u8  msg_data[];
+} __packed;
+
+struct hfi_debug_cfg {
+	u32 debug_config;
