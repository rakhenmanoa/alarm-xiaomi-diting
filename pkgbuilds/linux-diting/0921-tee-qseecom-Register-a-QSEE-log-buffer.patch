From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fanasina RANDRIATSARAFARA <m.randriatsarafara.f@gmail.com>
Date: Wed, 4 Nov 2026 10:00:00 +0300
Subject: [PATCH] tee: qseecom: Register a QSEE log buffer, show it in debugfs

Trusted applications log with qsee_log(), which the secure OS drops
until the normal world registers a log buffer (QSEE_OS/APP_MGR command
6, as downstream kernels do at boot). Without it, the only feedback
from an application such as the Goodix fingerprint one is a bare error
number.

Add qcom_scm_qseecom_register_log_buf() and have the QSEECOM TEE driver
register 64 KiB of TZ memory at probe, readable raw (wrap count, write
offset, then text) from debugfs as qseecom_tee/qsee_log. The buffer is
written by TZ from then on and is never freed.
---
diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -123,6 +123,7 @@
 	QSEECOM_TZ_CMD_APP_SEND			= 1,
 	QSEECOM_TZ_CMD_APP_SHUTDOWN		= 2,
 	QSEECOM_TZ_CMD_APP_LOOKUP		= 3,
+	QSEECOM_TZ_CMD_REGISTER_LOG_BUF		= 6,
 	QSEECOM_TZ_CMD_LOAD_SERVICE		= 7,
 };
 
@@ -2658,6 +2659,41 @@
 EXPORT_SYMBOL_GPL(qcom_scm_qseecom_app_shutdown);
 
 /**
+ * qcom_scm_qseecom_register_log_buf() - Give QSEE a buffer for its log.
+ * @buf:  TZ memory the secure OS and its applications will log into.
+ * @size: Size of @buf.
+ *
+ * Applications log through qsee_log(), which goes nowhere until the normal
+ * world hands over a buffer; downstream kernels do so at boot. The buffer is
+ * written by the secure world from then on, so it must never be freed.
+ *
+ * Return: Zero on success, nonzero on failure.
+ */
+int qcom_scm_qseecom_register_log_buf(void *buf, size_t size)
+{
+	struct qcom_scm_qseecom_resp res = {};
+	struct qcom_scm_desc desc = {};
+	int status;
+
+	desc.owner = QSEECOM_TZ_OWNER_QSEE_OS;
+	desc.svc = QSEECOM_TZ_SVC_APP_MGR;
+	desc.cmd = QSEECOM_TZ_CMD_REGISTER_LOG_BUF;
+	desc.arginfo = QCOM_SCM_ARGS(2, QCOM_SCM_RW, QCOM_SCM_VAL);
+	desc.args[0] = qcom_tzmem_to_phys(buf);
+	desc.args[1] = size;
+
+	status = qcom_scm_qseecom_call(&desc, &res);
+	if (status)
+		return status;
+
+	if (res.result != QSEECOM_RESULT_SUCCESS)
+		return -EIO;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_qseecom_register_log_buf);
+
+/**
  * qcom_scm_qseecom_app_send() - Send to and receive data from a given QSEE app.
  * @app_id:   The ID of the target app.
  * @req:      Request buffer sent to the app (must be TZ memory)
diff --git a/drivers/tee/qseecom/core.c b/drivers/tee/qseecom/core.c
--- a/drivers/tee/qseecom/core.c
+++ b/drivers/tee/qseecom/core.c
@@ -29,6 +29,7 @@
 
 #include <linux/capability.h>
 #include <linux/cleanup.h>
+#include <linux/debugfs.h>
 #include <linux/errno.h>
 #include <linux/elf.h>
 #include <linux/firmware.h>
@@ -152,8 +153,87 @@
 	struct mutex load_lock; /* Serializes firmware loading and registration. */
 	u32 next_app_gen;
 	struct list_head apps;
+	struct dentry *debugfs;
 };
 
+/*
+ * QSEE log. The secure OS and its applications (qsee_log()) write into a
+ * buffer the normal world registers once; without it their messages are
+ * dropped. Exposed raw in debugfs: a small header (wrap count and write
+ * offset) followed by text.
+ *
+ * TZ keeps writing into the buffer for as long as the machine runs, so it
+ * comes from a pool of its own that is never freed, not even when the module
+ * is removed: a deliberate leak of QSEECOM_TEE_LOG_SIZE bytes per load.
+ */
+#define QSEECOM_TEE_LOG_SIZE	SZ_64K
+
+static void *qseecom_tee_log;
+
+static ssize_t qseecom_tee_log_read(struct file *file, char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	void *copy;
+	ssize_t ret;
+
+	copy = kmalloc(QSEECOM_TEE_LOG_SIZE, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	memcpy(copy, qseecom_tee_log, QSEECOM_TEE_LOG_SIZE);
+	ret = simple_read_from_buffer(ubuf, count, ppos, copy,
+				      QSEECOM_TEE_LOG_SIZE);
+	kfree(copy);
+
+	return ret;
+}
+
+static const struct file_operations qseecom_tee_log_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = qseecom_tee_log_read,
+	.llseek = default_llseek,
+};
+
+static void qseecom_tee_log_init(struct qseecom_tee *qtee)
+{
+	struct qcom_tzmem_pool_config config = {
+		.initial_size = QSEECOM_TEE_LOG_SIZE,
+		.policy = QCOM_TZMEM_POLICY_STATIC,
+	};
+	struct qcom_tzmem_pool *pool;
+	void *buf;
+	int ret;
+
+	pool = qcom_tzmem_pool_new(&config);
+	if (IS_ERR(pool)) {
+		dev_warn(qtee->dev, "no pool for the QSEE log: %ld\n",
+			 PTR_ERR(pool));
+		return;
+	}
+
+	buf = qcom_tzmem_alloc(pool, QSEECOM_TEE_LOG_SIZE, GFP_KERNEL);
+	if (!buf) {
+		qcom_tzmem_pool_free(pool);
+		return;
+	}
+	memset(buf, 0, QSEECOM_TEE_LOG_SIZE);
+
+	ret = qcom_scm_qseecom_register_log_buf(buf, QSEECOM_TEE_LOG_SIZE);
+	if (ret) {
+		/* Not registered: TZ never saw it, so it can go. */
+		dev_warn(qtee->dev, "QSEE log buffer refused: %d\n", ret);
+		qcom_tzmem_free(buf);
+		qcom_tzmem_pool_free(pool);
+		return;
+	}
+
+	qseecom_tee_log = buf;
+	qtee->debugfs = debugfs_create_dir("qseecom_tee", NULL);
+	debugfs_create_file("qsee_log", 0400, qtee->debugfs, NULL,
+			    &qseecom_tee_log_fops);
+	dev_info(qtee->dev, "QSEE log in debugfs, qseecom_tee/qsee_log\n");
+}
+
 /**
  * struct qseecom_tee_listener - A listener service offered by a supplicant.
  * @scm:  Registration held by the SCM layer.
@@ -1915,6 +1995,8 @@
 
 	platform_set_drvdata(pdev, qtee);
 
+	qseecom_tee_log_init(qtee);
+
 	return 0;
 
 err_unreg_supp_teedev:
@@ -1932,6 +2014,8 @@
 	struct qseecom_tee *qtee = platform_get_drvdata(pdev);
 	struct qseecom_tee_app *app, *tmp;
 
+	/* The log buffer itself stays: TZ still writes into it. */
+	debugfs_remove_recursive(qtee->debugfs);
 	tee_device_unregister(qtee->supp_teedev);
 	tee_device_unregister(qtee->teedev);
 	tee_shm_pool_free(qtee->pool);
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -222,6 +222,7 @@
 int qcom_scm_qseecom_app_load(void *img, size_t mdt_len, size_t img_len,
 			      u32 *app_id);
 int qcom_scm_qseecom_app_shutdown(u32 app_id);
+int qcom_scm_qseecom_register_log_buf(void *buf, size_t size);
 int qcom_scm_qseecom_load_service(void *img, size_t mdt_len, size_t img_len,
 				  bool is64);
 int qcom_scm_qseecom_listener_register(struct qcom_scm_qseecom_listener *listener);
@@ -246,6 +247,11 @@
 {
 	return -EINVAL;
 }
+
+static inline int qcom_scm_qseecom_register_log_buf(void *buf, size_t size)
+{
+	return -EINVAL;
+}
 
 static inline int qcom_scm_qseecom_app_send(u32 app_id,
 					    void *req, size_t req_size,
-- 
2.43.0
