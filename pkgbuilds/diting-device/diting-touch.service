# Tactile Goodix GT9916 : en mode normal, le firmware retient les touchers
# des coins du bas (zones de prise en main) jusqu'au relâchement ; le
# clavier virtuel (&123, Entrée) répond alors en retard. Le mode jeu
# (commande 0x17, filtre de bord 0) les envoie aussitôt. Testé le
# 2026-10-26 avec libinput debug-events. Réappliqué après chaque veille
# par /usr/lib/systemd/system-sleep/diting-touch.
[Unit]
Description=Diting : tactile en mode jeu (coins du bas réactifs)
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in $(seq 30); do ls /sys/bus/spi/drivers/goodix-berlin-spi/*/registers >/dev/null 2>&1 && break; sleep 1; done; sleep 2; /usr/bin/diting-touch-cmd game 0'

[Install]
WantedBy=multi-user.target
