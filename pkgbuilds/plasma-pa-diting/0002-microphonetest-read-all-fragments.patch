From 63612ca04b2f9963a55db9691bd01edcc06dae68 Mon Sep 17 00:00:00 2001
From: alarm-diting <alarm@diting>
Date: Sat, 31 Oct 2026 12:39:31 +0300
Subject: [PATCH] microphonetest: Read all queued fragments in the read
 callback

pa_stream_peek() returns one fragment at a time, and the read callback
read a single one: when more than one was queued, the rest waited for
the next callback, the backlog grew and the level shown lagged further
and further behind the voice. Holes (data == nullptr with a size) were
never dropped, which stalls the stream.

Read until pa_stream_readable_size() is 0, and drop holes.
---
 src/microphonetest.cpp | 32 +++++++++++++++++++++-----------
 1 file changed, 21 insertions(+), 11 deletions(-)

diff --git a/src/microphonetest.cpp b/src/microphonetest.cpp
index a027d90..5640e81 100644
--- a/src/microphonetest.cpp
+++ b/src/microphonetest.cpp
@@ -419,22 +419,32 @@ void MicrophoneTest::stream_write_callback(pa_stream *s, size_t nbytes, void *us
 
 void MicrophoneTest::stream_read_callback(pa_stream *s, size_t nbytes, void *userdata)
 {
+    Q_UNUSED(nbytes)
     auto *self = static_cast<MicrophoneTest *>(userdata);
-    const void *data;
-
-    if (pa_stream_peek(s, &data, &nbytes) < 0 || !data) {
-        return;
-    }
-
     const bool wasEmpty = self->m_recordedData.isEmpty();
 
-    self->m_recordedData.append(static_cast<const char *>(data), nbytes);
-
-    self->calculateVolumeLevel(data, nbytes);
+    // pa_stream_peek() returns one fragment at a time. Reading a single one
+    // per callback left the others queued: the backlog grew, and the level
+    // shown came later and later after the voice. Read everything that is
+    // there, and drop holes too (data == nullptr with a size), which were
+    // never dropped and stalled the stream.
+    while (pa_stream_readable_size(s) > 0) {
+        const void *data = nullptr;
+        size_t size = 0;
+        if (pa_stream_peek(s, &data, &size) < 0) {
+            return;
+        }
+        if (size == 0) {
+            break;
+        }
+        if (data) {
+            self->m_recordedData.append(static_cast<const char *>(data), size);
+            self->calculateVolumeLevel(data, size);
+        }
+        pa_stream_drop(s);
+    }
 
     if (wasEmpty && !self->m_recordedData.isEmpty()) {
         Q_EMIT self->hasRecordingChanged();
     }
-
-    pa_stream_drop(s);
 }
