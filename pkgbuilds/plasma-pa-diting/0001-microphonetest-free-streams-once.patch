From 7853b75e62c184b48ea5c62f6273e441b4358888 Mon Sep 17 00:00:00 2001
From: alarm-diting <alarm@diting>
Date: Sat, 31 Oct 2026 12:36:41 +0300
Subject: [PATCH] microphonetest: Free the playback stream only once

The playback write callback starts a new drain on every write request
after the end of the recording, and each drain callback disconnected and
unreffed the stream, while m_playbackStream was only cleared later from
a queued call. When two drain callbacks run before that call,
plasma-settings aborts in pa_stream_unref.

Clear m_playbackStream in the drain callback itself and ignore drain
callbacks for a stream that is no longer the current one.
---
 src/microphonetest.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/microphonetest.cpp b/src/microphonetest.cpp
index 4cd9df2..a027d90 100644
--- a/src/microphonetest.cpp
+++ b/src/microphonetest.cpp
@@ -385,13 +385,18 @@ void MicrophoneTest::stream_write_callback(pa_stream *s, size_t nbytes, void *us
             s,
             [](pa_stream *s, int, void *userdata) {
                 auto *self = static_cast<MicrophoneTest *>(userdata);
-                if (!self || !self->m_playbackStream) return;
+                // Every write request after the end starts another drain, so
+                // several drain callbacks can come for the same stream before
+                // the queued call below runs: clear m_playbackStream here, or
+                // the stream is disconnected and unreffed twice (abort in
+                // pa_stream_unref).
+                if (!self || s != self->m_playbackStream) return;
+                self->m_playbackStream = nullptr;
 
                 pa_stream_disconnect(s);
                 pa_stream_unref(s);
 
                 QMetaObject::invokeMethod(self, [self]() {
-                    self->m_playbackStream = nullptr;
                     self->m_playing = false;
                     Q_EMIT self->playingChanged();
                     Q_EMIT self->playbackFinished();
-- 
