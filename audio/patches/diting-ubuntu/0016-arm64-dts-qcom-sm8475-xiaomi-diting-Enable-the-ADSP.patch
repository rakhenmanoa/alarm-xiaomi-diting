From: royka1 <397414+royka1@users.noreply.github.com>
Date: Mon, 12 Oct 2026 13:35:31 +0200
Subject: [PATCH 16/46] arm64: dts: qcom: sm8475-xiaomi-diting: Enable the ADSP

The firmware is the vendor adsp.mdt/bNN from the firmware_mnt partition,
squashed into one image.
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 9967ca673..dc96511a3 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -485,6 +485,12 @@ eusb2_repeater: redriver@4f {
 	};
 };
 
+&remoteproc_adsp {
+	/* squashed from the vendor firmware_mnt adsp.mdt + adsp.bNN */
+	firmware-name = "qcom/sm8475/xiaomi/diting/adsp.mbn";
+	status = "okay";
+};
+
 &gpu {
 	status = "okay";
 
