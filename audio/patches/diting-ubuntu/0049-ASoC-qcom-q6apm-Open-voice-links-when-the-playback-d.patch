From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Mon, 12 Oct 2026 22:11:59 +0200
Subject: [PATCH] ASoC: qcom: q6apm: Open voice links when the playback device
 graph opens

The speaker endpoint (TDM/I2S sink) creates control ports for links of
an open hostless voice graph only before its device graph is prepared;
links sent from the front end prepare, after DPCM prepared the back end,
were all rejected. Let the back end open the voice graph's playback links
right after it opened the playback device graph.

Local bring-up patch, not for upstream submission.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/qcom/qdsp6/audioreach.h       |  4 +-
 sound/soc/qcom/qdsp6/q6apm-lpass-dais.c |  6 +++
 sound/soc/qcom/qdsp6/q6apm.c            | 56 ++++++++++++++++++++-----
 sound/soc/qcom/qdsp6/q6apm.h            |  1 +
 4 files changed, 55 insertions(+), 12 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 9f72f380d..0bc8ca4d8 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -936,8 +936,8 @@ int audioreach_set_module_config_late(struct q6apm_graph *graph,
 
 /*
  * order of use: GRAPH_OPEN, SET, PERSISTENT, SET_LATE; PLAYBACK_LINKS is a
- * graph open command with links to the playback device graph, sent when a
- * hostless graph is prepared for playback (that device graph exists then)
+ * graph open command with links to the playback device graph, sent when the
+ * back end has opened that device graph and before it prepares it
  */
 #define AR_MODULE_CFG_SET		0
 #define AR_MODULE_CFG_PERSISTENT	1
diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
index bb8cc289b..89833019d 100644
--- a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
+++ b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
@@ -210,6 +210,12 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 			return rc;
 		}
 		dai_data->graph[graph_id] = graph;
+
+		rc = q6apm_graph_open_peer_links(graph);
+		if (rc) {
+			dev_err(dai->dev, "Failed to link graph %d: %d\n", graph_id, rc);
+			goto err;
+		}
 	}
 
 	cfg->direction = substream->stream;
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 2dd97526c..9d030be80 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -690,9 +690,8 @@ EXPORT_SYMBOL_GPL(q6apm_graph_is_hostless);
  * command per parameter; a link the device modules do not support is
  * reported and skipped.
  */
-static int q6apm_graph_open_playback_links(struct q6apm_graph *graph)
+static int q6apm_open_playback_links(struct q6apm *apm, struct audioreach_graph_info *info)
 {
-	struct audioreach_graph_info *info = graph->info;
 	struct audioreach_container *container;
 	struct audioreach_module *module;
 	struct audioreach_sub_graph *sgs;
@@ -716,9 +715,9 @@ static int q6apm_graph_open_playback_links(struct q6apm_graph *graph)
 					if (IS_ERR(pkt))
 						return PTR_ERR(pkt);
 					memcpy((void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE, pd, len);
-					ret = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+					ret = q6apm_send_cmd_sync(apm, pkt, 0);
 					if (ret == -EINVAL)
-						dev_warn(graph->dev, "playback link %zu of 0x%x rejected\n",
+						dev_warn(apm->dev, "playback link %zu of 0x%x rejected\n",
 							 off, module->instance_id);
 					else if (ret)
 						return ret;
@@ -730,6 +729,49 @@ static int q6apm_graph_open_playback_links(struct q6apm_graph *graph)
 	return 0;
 }
 
+static bool q6apm_graph_info_has_playback_links(struct audioreach_graph_info *info)
+{
+	struct audioreach_container *container;
+	struct audioreach_module *module;
+	struct audioreach_sub_graph *sgs;
+
+	list_for_each_entry(sgs, &info->sg_list, node)
+		list_for_each_entry(container, &sgs->container_list, node)
+			list_for_each_entry(module, &container->modules_list, node)
+				if (module->cfg_size[AR_MODULE_CFG_PLAYBACK_LINKS])
+					return true;
+	return false;
+}
+
+/*
+ * Called by the back end right after it opened a playback device graph and
+ * before preparing it: the device endpoint creates the control ports for
+ * links of an already open hostless (voice) graph only in that state.
+ */
+int q6apm_graph_open_peer_links(struct q6apm_graph *dev_graph)
+{
+	struct q6apm *apm = dev_graph->apm;
+	struct audioreach_graph_info *info = NULL;
+	struct audioreach_graph *ar_graph;
+	int id;
+
+	mutex_lock(&apm->lock);
+	idr_for_each_entry(&apm->graph_idr, ar_graph, id) {
+		if (ar_graph->id != dev_graph->id &&
+		    q6apm_graph_info_has_playback_links(ar_graph->info)) {
+			info = ar_graph->info;
+			break;
+		}
+	}
+	mutex_unlock(&apm->lock);
+
+	if (!info)
+		return 0;
+
+	return q6apm_open_playback_links(apm, info);
+}
+EXPORT_SYMBOL_GPL(q6apm_graph_open_peer_links);
+
 int q6apm_graph_hostless_config(struct q6apm_graph *graph, int dir)
 {
 	struct audioreach_graph_info *info = graph->info;
@@ -748,12 +790,6 @@ int q6apm_graph_hostless_config(struct q6apm_graph *graph, int dir)
 		}
 	}
 
-	if (dir == SNDRV_PCM_STREAM_PLAYBACK) {
-		ret = q6apm_graph_open_playback_links(graph);
-		if (ret)
-			return ret;
-	}
-
 	/* e.g. VCPM: the session (VSID) first, then its calibration tables */
 	ret = q6apm_graph_register_cal(graph);
 	if (ret)
diff --git a/sound/soc/qcom/qdsp6/q6apm.h b/sound/soc/qcom/qdsp6/q6apm.h
index 2d574a68b..4e3a722f2 100644
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -141,6 +141,7 @@ int q6apm_graph_flush(struct q6apm_graph *graph);
 /* Media Format */
 bool q6apm_graph_is_hostless(struct q6apm_graph *graph);
 int q6apm_graph_hostless_config(struct q6apm_graph *graph, int dir);
+int q6apm_graph_open_peer_links(struct q6apm_graph *dev_graph);
 int q6apm_graph_media_format_pcm(struct q6apm_graph *graph,
 				 struct audioreach_module_config *cfg);
 
