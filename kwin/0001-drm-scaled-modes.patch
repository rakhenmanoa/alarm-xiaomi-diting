+// KWIN_DRM_SCALED_MODES="2,3" -> for every native mode, also offer modes at
+// 1/2 and 1/3 of the native resolution, upscaled by the primary plane.
+static const QList<double> s_scaledModeFactors = []() {
+    QList<double> ret;
+    const QString env = qEnvironmentVariable("KWIN_DRM_SCALED_MODES");
+    for (const QString &part : env.split(QLatin1Char(','), Qt::SkipEmptyParts)) {
+        bool ok = false;
+        const double factor = part.trimmed().toDouble(&ok);
+        if (ok && factor > 1.0 && factor <= 4.0) {
+            ret.push_back(factor);
+        }
+    }
+    return ret;
+}();
+
+QList<std::shared_ptr<DrmConnectorMode>> DrmConnector::generateScaledModes()
+{
+    QList<std::shared_ptr<DrmConnectorMode>> ret;
+    for (const auto &mode : std::as_const(m_driverModes)) {
+        const QSize native = mode->size();
+        for (const double factor : s_scaledModeFactors) {
+            const QSize scaled(std::lround(native.width() / factor), std::lround(native.height() / factor));
+            if (scaled.width() < 320 || scaled.height() < 320) {
+                continue;
+            }
+            const bool alreadyExists = std::ranges::any_of(ret, [&](const auto &other) {
+                return other->size() == scaled && other->refreshRate() == mode->refreshRate();
+            });
+            if (alreadyExists) {
+                continue;
+            }
+            ret.push_back(std::make_shared<DrmConnectorMode>(this, *mode->nativeMode(), scaled, mode->refreshRate()));
+        }
+    }
+    return ret;
+}
