+// KWIN_DRM_SCALED_NEAREST=0 -> let the display controller upscale scaled modes (bilinear)
+static const bool s_scaledModesNearest = environmentVariableBoolValue("KWIN_DRM_SCALED_NEAREST").value_or(true);
+
+/*
+ * For a scaled mode with a (nearly) integer factor, KWin itself upscales the primary
+ * layer with nearest-neighbor filtering: the scene is rendered at the small size and
+ * then drawn into a buffer of the native size. Returns the size of that native buffer,
+ * or an invalid size if the display controller should do the scaling instead.
+ */
+static QSize nearestUpscaleBufferSize(DrmPipeline *pipeline, OutputLayerType type, const QSize &renderSize)
+{
+    if (!s_scaledModesNearest || type != OutputLayerType::Primary || !pipeline || renderSize.isEmpty()) {
+        return QSize();
+    }
+    const auto mode = pipeline->mode();
+    if (!mode || !mode->isScaled()) {
+        return QSize();
+    }
+    const QSize native = mode->scanoutSize();
+    const int factor = std::lround(double(native.width()) / renderSize.width());
+    if (factor < 2
+        || std::abs(native.width() - renderSize.width() * factor) > factor
+        || std::abs(native.height() - renderSize.height() * factor) > factor) {
+        return QSize();
+    }
+    return native;
+}
